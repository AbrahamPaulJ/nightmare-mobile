+      // width and height but different channel counts would blend element-wise
+      // into something shaped like a latent and meaning nothing.
+      if (la.width != lb.width || la.height != lb.height ||
+          la.channels != lb.channels || la.data.size() != lb.data.size())
+        throw std::invalid_argument(
+            "latents differ: a is " + std::to_string(la.channels) + "x" +
+            std::to_string(la.height / 8) + "x" + std::to_string(la.width / 8) +
+            " (" + std::to_string(la.data.size()) + " floats), b is " +
+            std::to_string(lb.channels) + "x" + std::to_string(lb.height / 8) +
+            "x" + std::to_string(lb.width / 8) + " (" +
+            std::to_string(lb.data.size()) + ")");
+
+      const int sample_w = la.width / 8;
+      const int sample_h = la.height / 8;
+      const size_t plane = (size_t)sample_h * sample_w;
+      if (la.data.size() != plane * (size_t)la.channels)
+        throw std::runtime_error("latent size does not match its dimensions");
+
+      // The mask, at latent resolution. ⚠ A missing mask is an error rather
+      // than an implicit 0.5: "blend these two latents somehow" is not a thing
+      // a caller means.
+      const std::string mask_b64 = json.at("mask").get<std::string>();
+      const std::string mask_bytes_str = base64_decode(mask_b64);
+      std::vector<uint8_t> mask_buf(mask_bytes_str.begin(),
+                                    mask_bytes_str.end());
+      std::vector<uint8_t> mask_rgb;
+      decode_image(mask_buf, mask_rgb, sample_w, sample_h);
+      if (mask_rgb.size() != plane * 3)
+        throw std::invalid_argument(
+            "mask decoded to " + std::to_string(mask_rgb.size()) +
+            " bytes, expected " + std::to_string(plane * 3) + " for " +
+            std::to_string(sample_w) + "x" + std::to_string(sample_h));
+
+      std::vector<float> mask(plane);
+      for (size_t i = 0; i < plane; ++i) {
+        // Mean of RGB, matching RequestParser. A mask is greyscale by
+        // convention; averaging is what makes an accidentally-coloured one
+        // behave sensibly instead of taking an arbitrary channel.
+        const float m = ((float)mask_rgb[i * 3] + (float)mask_rgb[i * 3 + 1] +
+                         (float)mask_rgb[i * 3 + 2]) /
+                        3.0f / 255.0f;
+        mask[i] = m;
+      }
+
+      LatentHandle out;
+      out.width = la.width;
+      out.height = la.height;
+      out.channels = la.channels;
+      out.data.resize(la.data.size());
+      for (int c = 0; c < la.channels; ++c) {
+        for (size_t i = 0; i < plane; ++i) {
+          const size_t k = (size_t)c * plane + i;
+          // The mask is a single spatial plane replicated across channels,
+          // exactly as the inpaint path replicates it.
+          out.data[k] = la.data[k] * (1.0f - mask[i]) + lb.data[k] * mask[i];
