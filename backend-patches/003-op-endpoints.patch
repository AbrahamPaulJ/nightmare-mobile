+          "lat_" + Sha256::hashHex(ha + "\x1f" + hb + "\x1f" + mask_sha);
+      const std::string lat_sha = Sha256::hashHex(
+          std::string(reinterpret_cast<const char *>(out.data.data()),
+                      out.data.size() * sizeof(float)),
+          16);
+
+      nlohmann::json body = {{"ok", true},
+                             {"handle", handle},
+                             {"channels", out.channels},
+                             {"width", out.width},
+                             {"height", out.height},
+                             {"floats", out.data.size()},
+                             {"latent_sha", lat_sha},
+                             {"mask_sha", mask_sha}};
+      {
+        std::lock_guard<std::mutex> hl(g_handle_mutex);
+        g_latent_handles[handle] = std::move(out);
+        body["latents_resident"] = g_latent_handles.size();
+      }
+      res.status = 200;
+      res.set_content(body.dump(), "application/json");
+    } catch (const std::exception &e) {
+      nlohmann::json err = {
+          {"error",
+           {{"message", std::string(e.what())}, {"type", "latent_blend_error"}}}};
+      res.status = 400;
+      res.set_content(err.dump(), "application/json");
+    }
+  });
+
+  // Inspect the handle table. The executor needs to know what is resident
+  // before it decides what to recompute.
+  //
+  // ⚠⚠ BOTH tables. The first version walked only g_cond_handles, so a
+  // /sample that had just registered a latent was answered with `count: 0` --
+  // measured 2026-09-08, right after the app rendered from that very handle.
+  // An executor trusting that would recompute every latent it already had, and
+  // the symptom would be a graph that is merely SLOW: every answer correct,
+  // every cache miss invisible. A resident-set report that omits a kind of
+  // resident thing is worse than no report.
+  svr.Get("/handles", [](const httplib::Request &, httplib::Response &res) {
+    nlohmann::json arr = nlohmann::json::array();
+    size_t n_cond = 0, n_lat = 0;
+    {
+      std::lock_guard<std::mutex> hl(g_handle_mutex);
+      for (const auto &kv : g_cond_handles) {
+        ++n_cond;
+        arr.push_back({{"handle", kv.first},
+                       // ⚠ Tagged. The two kinds carry different fields, and a
+                       // caller that had to infer the kind from which fields
+                       // happened to be present would guess wrong the first
+                       // time a field was added.
+                       {"kind", "conditioning"},
+                       {"seq_len", kv.second.seq_len},
+                       {"hidden_dim", kv.second.hidden_dim},
+                       {"floats", kv.second.hidden.size()}});
+      }
+      for (const auto &kv : g_latent_handles) {
+        ++n_lat;
+        arr.push_back({{"handle", kv.first},
+                       {"kind", "latent"},
+                       {"channels", kv.second.channels},
+                       {"width", kv.second.width},
+                       {"height", kv.second.height},
+                       {"floats", kv.second.data.size()}});
+      }
+    }
+    nlohmann::json out = {{"ok", true},
+                          {"count", arr.size()},
+                          {"conditioning", n_cond},
+                          {"latents", n_lat},
+                          {"handles", arr}};
+    res.status = 200;
+    res.set_content(out.dump(), "application/json");
+  });
+}
