+      {
+        std::lock_guard<std::mutex> hl(g_handle_mutex);
+        auto ia = g_latent_handles.find(ha);
+        if (ia == g_latent_handles.end())
+          throw std::invalid_argument("unknown latent handle a: " + ha);
+        auto ib = g_latent_handles.find(hb);
+        if (ib == g_latent_handles.end())
+          throw std::invalid_argument("unknown latent handle b: " + hb);
+        la = ia->second;
+        lb = ib->second;
+      }
