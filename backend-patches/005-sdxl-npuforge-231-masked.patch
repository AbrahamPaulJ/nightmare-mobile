+      if (ids[77 * c] != 49406) continue;
+      std::vector<float> e1(emb1.begin() + 77 * c * text_embedding_size,
+                            emb1.begin() + 77 * (c + 1) * text_embedding_size);
+      std::vector<float> e2(
+          emb2.begin() + 77 * c * text_embedding_size_2,
+          emb2.begin() + 77 * (c + 1) * text_embedding_size_2);
+      runDualClip(e1, e2, ids + 77 * c, out_hidden + 77 * c * hid,
+                  c == 0 ? out_pooled : pooled.data());
