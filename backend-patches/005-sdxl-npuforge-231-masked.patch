+  // SDXL LONG context (npuforge `231_masked_v1`): the prompt is split into
+  // CHUNKS of 77 -- each its own BOS + up to 75 tokens + EOS/pad, with its own
+  // position embeddings -- concatenated to max_len (a multiple of 77). Each
+  // chunk is laid out exactly as processWeightedPrompt's 77-token one.
+  // A chunk the prompt does not reach stays all-zero and its ids[77*k] is 0,
+  // not BOS: that is how encodeText and the UNet mask tell it is unused.
+  ProcessedPrompt processChunkedPrompt(const std::string &prompt_text,
+                                       int max_len) {
+    const int chunks = max_len / 77;
+    const int dim1 = 768;
+    const int dim2 = text_embedding_size_2;
+
+    struct Tok {
+      int id;
+      float weight;
+      const float *emb1;
+      const float *emb2;
+    };
+    std::vector<Tok> content;
+    auto tokens = promptProcessor_.process(prompt_text);
+    for (const auto &token : tokens) {
+      if (token.is_embedding) {
+        int n = 0;
+        if (!token.embedding_data.empty())
+          n = token.embedding_data.size() / dim1;
+        else if (!token.embedding_data_2.empty())
+          n = token.embedding_data_2.size() / dim2;
+        for (int i = 0; i < n; i++) {
+          content.push_back(
+              {49407, token.weight,
+               token.embedding_data.empty()
+                   ? nullptr
+                   : token.embedding_data.data() + i * dim1,
+               token.embedding_data_2.empty()
+                   ? nullptr
+                   : token.embedding_data_2.data() + i * dim2});
+        }
+      } else {
+        for (int tid : tokenizer_->Encode(token.text))
+          content.push_back({tid, token.weight, nullptr, nullptr});
+      }
+    }
+    const int used =
+        std::max(1, std::min(chunks, (int)((content.size() + 74) / 75)));
+
+    ProcessedPrompt result;
+    result.ids.assign(max_len, 0);
+    result.ids_2.assign(max_len, 0);
+    result.weighted_embeddings.assign((size_t)max_len * dim1, 0.0f);
+    result.weighted_embeddings_2.assign((size_t)max_len * dim2, 0.0f);
+
+    for (int c = 0; c < used; c++) {
+      std::vector<float> e1(77 * dim1, 0.0f), e2(77 * dim2, 0.0f);
+      std::vector<int> ids{49406};
+      std::vector<float> weights{1.0f};
+      for (int k = 0; k < 75; k++) {
+        size_t at = (size_t)c * 75 + k;
+        if (at >= content.size()) break;
+        const Tok &t = content[at];
+        int pos = (int)ids.size();
+        if (t.emb1)
+          for (int j = 0; j < dim1; j++)
+            e1[pos * dim1 + j] = t.emb1[j] * t.weight;
+        if (t.emb2)
+          for (int j = 0; j < dim2; j++)
+            e2[pos * dim2 + j] = t.emb2[j] * t.weight;
+        ids.push_back(t.id);
+        weights.push_back(t.weight);
+      }
+      while (ids.size() < 77) {
+        ids.push_back(49407);
+        weights.push_back(1.0f);
+      }
+      std::vector<int> ids2 = ids;
+      for (int i = 1; i < 77; i++) {
+        if (ids2[i] == 49407) {
+          for (int k = i + 1; k < 77; k++) ids2[k] = 0;
+          break;
+        }
+      }
+      if (!token_emb_.empty() && !pos_emb_.empty())
+        applyTokenAndPosEmb(ids, weights, token_emb_, pos_emb_, dim1, 77, e1);
+      if (!token_emb_2_.empty() && !pos_emb_2_.empty())
+        applyTokenAndPosEmb(ids2, weights, token_emb_2_, pos_emb_2_, dim2, 77,
+                            e2);
+
+      std::copy(ids.begin(), ids.end(), result.ids.begin() + 77 * c);
+      std::copy(ids2.begin(), ids2.end(), result.ids_2.begin() + 77 * c);
+      std::copy(e1.begin(), e1.end(),
+                result.weighted_embeddings.begin() + (size_t)77 * c * dim1);
+      std::copy(e2.begin(), e2.end(),
+                result.weighted_embeddings_2.begin() + (size_t)77 * c * dim2);
+    }
+    return result;
+  }
