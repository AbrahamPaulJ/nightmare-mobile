+  // restored from the prompt cache or an /encode_text handle (hidden + pooled
+  // only) gets the right mask too.
+  static std::vector<float> chunkMask(const float *hidden) {
+    const size_t hid = text_embedding_size + text_embedding_size_2;
+    std::vector<float> mask(kLongSeq, 0.0f);
+    for (int c = 0; c < kLongSeq / 77; c++) {
