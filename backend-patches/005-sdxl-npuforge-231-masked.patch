+  // Each chunk through both encoders; a chunk the prompt does not reach
+  // (ids[77*c] != BOS) stays zero. Pooled comes from the FIRST chunk.
+  void runChunkedClip(const std::vector<float> &emb1,
+                      const std::vector<float> &emb2, const int *ids,
+                      float *out_hidden, float *out_pooled) {
+    const size_t hid = text_embedding_size + text_embedding_size_2;
+    std::fill(out_hidden, out_hidden + kLongSeq * hid, 0.0f);
+    std::vector<float> pooled(text_embedding_size_2);
