+  // nightmare (037): A1111's `slerp` (modules/processing.py) between two noises.
+  static xt::xarray<float> slerpNoise(float val, const xt::xarray<float> &low,
+                                      const xt::xarray<float> &high) {
+    double nl = 0.0, nh = 0.0, dot = 0.0;
+    for (size_t i = 0; i < low.size(); ++i) {
+      nl += (double)low.data()[i] * low.data()[i];
+      nh += (double)high.data()[i] * high.data()[i];
+      dot += (double)low.data()[i] * high.data()[i];
+    }
+    dot /= std::sqrt(nl) * std::sqrt(nh);
+    if (std::abs(dot) > 0.9995) return xt::eval((1.0f - val) * low + val * high);
+    const double omega = std::acos(dot), so = std::sin(omega);
+    const float a = (float)(std::sin((1.0 - val) * omega) / so);
+    const float b = (float)(std::sin(val * omega) / so);
+    return xt::eval(a * low + b * high);
+  }
