   // engine .so ships in the APK's native library directory, which the app
   // passes as --lib_dir for these types; its FastRPC skels are copied from
   // assets into the runtime directory on the DSP search path.
+  // Wan 2.2 TI2V 5B (backend 028, engine ABI 106): a GGUF DiT, a umT5 text
+  // encoder and the TAEHV tiny decoder, all in the model's own directory. The
+  // text encoder runs on the CPU from a memory map, as measured with sd-cli
+  // (docs/VIDEO-GGML.md): ~5 s for a short prompt, and its pages stay
+  // reclaimable instead of pinned beside the DiT.
+  if (opts.isWan()) {
+    const std::string dit_path = (dir / "dit.gguf").string();
+    const std::string t5_path = (dir / "umt5.gguf").string();
+    const std::string tae_path = (dir / "tae.safetensors").string();
+    for (const auto &p : {dit_path, t5_path, tae_path}) {
+      if (!std::filesystem::exists(p)) showHelpAndExit("File not found: " + p);
+    }
+    if (opts.lib_dir.empty()) showHelpAndExit("Missing --lib_dir for DiT");
+    const std::string engine_path =
+        (std::filesystem::path(opts.lib_dir) / "libdit_engine.so").string();
+    if (!std::filesystem::exists(engine_path))
+      showHelpAndExit("DiT engine not installed: " + engine_path);
+    std::string backend = "diffusion=HTP0,te=CPU,vae=HTP0";
+    if (const char *env_backend = std::getenv("NM_DIT_BACKEND");
+        env_backend != nullptr && *env_backend != '\0') {
+      backend = env_backend;
+      std::cout << "NM_DIT_BACKEND override: " << backend << std::endl;
+    }
+    return std::make_unique<PipelineDit>(
+        text_encoder, opts.model_dir, engine_path, dit_path, "", "", "",
+        DIT_MODEL_WAN, backend, opts.dit_params_backend, opts.dit_threads,
+        /*vae_tile_size=*/0, /*img2img_enabled=*/false, /*lora_apply_mode=*/0,
+        t5_path, tae_path);
+  }
+
