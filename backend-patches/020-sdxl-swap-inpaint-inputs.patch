+  // mask plane (latent grid, 1 = repaint) + VAE latent of the image with the
+  // masked region blanked -- the inpainting conditioning. Shared by the
+  // 9-channel PipelineSd15Inpaint (it concatenates them into the UNet input),
+  // the SD 1.5 Swap v3 template (its `mask` / `masked_latent` inputs, patch
+  // 017) and the SDXL Swap template's inpaint branch (patch 020) -- which is
+  // why it lives HERE: vaeToLatents scales by the family's own factor
+  // (0.18215 / 0.13025) and the latent grid is sample_width x sample_height.
+  // Mirrors StableDiffusionInpaintPipeline's construction so
+  // the runtime input distribution matches what the graph was calibrated on.
+  void prepareInpaintConditioning(const GenerationRequest &req) {
+    const size_t plane = (size_t)sample_width * sample_height;
+    const size_t px = (size_t)req.width * req.height;
+
+    // ⭐⭐ NO MASK = REPAINT THE WHOLE FRAME (nightmare-mobile, 2026-09-19).
+    // This used to throw, which made a 9-channel checkpoint an inpaint-only
+    // model. With the mask all ones, `image * (mask < 0.5)` is zero
+    // everywhere, so the masked-image latent is the encode of a mid-grey
+    // frame -- exactly what diffusers' StableDiffusionInpaintPipeline feeds
+    // for a full mask -- and the same graph serves txt2img (no image at all)
+    // and img2img (the image arrives as the starting latent, not here).
+    std::vector<float> masked_image(3 * px, 0.0f);
+    if (!req.has_mask) {
+      mask_lat_.assign(plane, 1.0f);
+    } else {
+      if (!req.img2img || req.img_data.empty())
+        throw std::invalid_argument("inpainting requires an input image");
+      if (req.mask_data.size() < plane)
+        throw std::invalid_argument("mask_data too small for latent grid");
+
+      // --- mask channel ----------------------------------------------------
+      // RequestParser already decoded the mask straight to the latent grid
+      // and replicated it across all 4 channels; we need exactly one plane.
+      mask_lat_.assign(req.mask_data.begin(), req.mask_data.begin() + plane);
+
+      // --- masked-image latent --------------------------------------------
+      // img_data is NCHW in [-1, 1] (RequestParser: pixel/127.5 - 1), which
+      // is the same convention diffusers uses, so `image * (mask < 0.5)` maps
+      // directly: the masked region becomes 0, i.e. mid-grey.
+      if (req.img_data.size() < 3 * px || req.mask_data_full.size() < px)
+        throw std::invalid_argument("image/mask buffers too small");
+
+      for (int c = 0; c < 3; ++c) {
+        const float *src = req.img_data.data() + (size_t)c * px;
+        float *dst = masked_image.data() + (size_t)c * px;
+        // mask_data_full is [1,3,H,W] with the same value in every channel;
+        // channel 0 is representative.
+        const float *m = req.mask_data_full.data();
+        for (size_t i = 0; i < px; ++i) dst[i] = (m[i] < 0.5f) ? src[i] : 0.0f;
+      }
+    }
+
+    // ⚠ Not vaeEncode() directly. The VAE encoder graph is fixed at 512x512,
+    // but vaeEncode copies `3 * output_width * output_height` elements into its
+    // input tensor -- so at 768x512 it wrote 1,179,648 elements into a 786,432
+    // buffer and the server died with SIGSEGV/SEGV_ACCERR before the first
+    // step. 512x512 survived only because there the two are equal.
+    //
+    // encodePixelsToLatentStats() tiles when the input exceeds the graph, which
+    // is what the ordinary img2img path has always done; inpaint conditioning
+    // was the one caller that bypassed it. Found by the first non-square
+    // inpaint ever run (AbsoluteReality 768x512, 2026-08-12).
+    xt::xarray<float> masked_nchw =
+        xt::adapt(masked_image, std::vector<int>{1, 3, req.height, req.width});
+    std::vector<float> enc_mean, enc_std;
+    encodePixelsToLatentStats(req, masked_nchw, enc_mean, enc_std);
+
+    // Take the distribution mean rather than sampling it. The masked-image
+    // latent is pure conditioning -- it is not the tensor being denoised -- so
+    // the sampling noise would only add variance to the signal telling the
+    // model what the surroundings look like.
+    xt::xarray<float> lat =
+        xt::adapt(enc_mean, {1, 4, sample_height, sample_width});
+    vaeToLatents(lat);  // model-space scaling, as diffusers does
+    masked_lat_.assign(lat.begin(), lat.end());
+
+    std::cout << "Inpaint conditioning ready: mask coverage "
+              << (int)(100.0f *
+                       (std::accumulate(mask_lat_.begin(), mask_lat_.end(),
+                                        0.0f) /
+                        (float)plane))
+              << "%" << std::endl;
+  }
+
+  std::vector<float> mask_lat_;    // [1,1,h,w], 1 = repaint
+  std::vector<float> masked_lat_;  // [1,4,h,w], model-space
+
   TextEncoder &text_encoder_;
   const std::string model_dir_;
   const bool sdxl_;
