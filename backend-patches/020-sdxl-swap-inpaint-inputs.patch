+  // npuforge writes `swap_features.json` beside an SDXL Swap export:
+  // {"template":"sdxl_swap_v2","features":["inp", ...]} -- the features its
+  // UNet kept. Read from the file, not unet_->hasInput(): in --lowram the UNet
+  // is not loaded when /sample asks isInpaintModel(). beginDenoise checks the
+  // inputs are really there once it is.
+  static bool readSwapInpaint(const std::string &model_dir) {
+    std::ifstream f(std::filesystem::path(model_dir) / "swap_features.json");
+    if (!f) return false;
+    const std::string s((std::istreambuf_iterator<char>(f)),
+                        std::istreambuf_iterator<char>());
+    const size_t at = s.find("\"features\"");
+    return at != std::string::npos &&
+           s.find("\"inp\"", at) != std::string::npos;
+  }
