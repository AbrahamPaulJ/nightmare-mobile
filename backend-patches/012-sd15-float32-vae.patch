+  // An SD 1.5 VAE context comes in two I/O contracts: xororz's quantized
+  // UFIXED_16 tensors, and npuforge's FLOAT_32 (fp16 inside). The type is read
+  // off the tensor, so a quantized graph takes exactly the path it always did.
+  static bool isFloat32Tensor(const Qnn_Tensor_t &t) {
+    return t.v1.dataType == QNN_DATATYPE_FLOAT_32;
+  }
+
+  // Sized from the graph's own dimensions, like convertToFloatInto, so a tile
+  // or resolution that differs from output_/sample_width cannot overrun.
+  static size_t tensorElementCount(const Qnn_Tensor_t &t) {
+    size_t n = 1;
+    for (uint32_t i = 0; i < t.v1.rank; ++i) n *= t.v1.dimensions[i];
+    return n;
+  }
+
+  static void writeVaeInput(Qnn_Tensor_t &t, float *src, int elementCount) {
+    if (isFloat32Tensor(t)) {
+      memcpy(static_cast<float *>(QNN_TENSOR_GET_CLIENT_BUF(t).data), src,
+             tensorElementCount(t) * sizeof(float));
+      return;
+    }
+    qnn::tools::datautil::floatToTfN(
+        static_cast<uint16_t *>(QNN_TENSOR_GET_CLIENT_BUF(t).data), src,
+        t.v1.quantizeParams.scaleOffsetEncoding.offset,
+        t.v1.quantizeParams.scaleOffsetEncoding.scale, elementCount);
+  }
+
+  bool readVaeOutput(float *dst, Qnn_Tensor_t *t) {
+    if (isFloat32Tensor(*t)) {
+      memcpy(dst, static_cast<float *>(QNN_TENSOR_GET_CLIENT_BUF(*t).data),
+             tensorElementCount(*t) * sizeof(float));
+      return true;
+    }
+    return qnn::tools::iotensor::StatusCode::SUCCESS ==
+           m_ioTensor.convertToFloatInto(dst, t);
+  }
+
