+  struct VideoCallbacks {
+    const ProgressCallback *progress = nullptr;
+    const FrameSink *sink = nullptr;
+    std::exception_ptr pending;
+    std::string preview_format;
+    std::string preview_b64;
+    int first_step_ms = 0;
+    int sample_steps = 1;
+    int sampled_steps = 0;
+    int frames = 0;
+    int width = 0;
+    int height = 0;
+  };
+
+  // Sampling steps, then one slot for the decode, which finishes when the
+  // first frame arrives.
+  static bool forwardVideoProgress(int step, int total_steps,
+                                   float step_seconds, void *user_data) {
+    auto *cb = static_cast<VideoCallbacks *>(user_data);
+    if (total_steps > 0) {
+      cb->sampled_steps =
+          std::max(cb->sampled_steps, std::clamp(step, 0, total_steps));
+      if (step == 1)
+        cb->first_step_ms = static_cast<int>(step_seconds * 1000.0f);
+    }
+    try {
+      (*cb->progress)(cb->sampled_steps, cb->sample_steps + 1,
+                      cb->preview_b64);
+      cb->preview_b64.clear();
+      return true;
+    } catch (...) {
+      cb->pending = std::current_exception();
+      return false;
+    }
+  }
+
+  static void forwardVideoPreview(int, const uint8_t *rgb, int width,
+                                  int height, void *user_data) {
+    auto *cb = static_cast<VideoCallbacks *>(user_data);
+    if (!rgb || width <= 0 || height <= 0) return;
+    std::vector<uint8_t> data(
+        rgb, rgb + static_cast<size_t>(width) * height * 3);
+    data = cb->preview_format == "png" ? encodePNG(data, width, height)
+                                       : encodeJPEG(data, width, height, 75);
+    cb->preview_b64 = base64_encode(std::string(data.begin(), data.end()));
+  }
+
+  static bool forwardVideoFrame(int index, int count, const uint8_t *rgb,
+                                int width, int height, void *user_data) {
+    auto *cb = static_cast<VideoCallbacks *>(user_data);
+    try {
+      (*cb->sink)(index, count, rgb, width, height);
+      cb->frames = index + 1;
+      cb->width = width;
+      cb->height = height;
+      if (index == 0)
+        (*cb->progress)(cb->sample_steps + 1, cb->sample_steps + 1, "");
+      return true;
+    } catch (...) {
+      cb->pending = std::current_exception();
+      return false;
+    }
+  }
