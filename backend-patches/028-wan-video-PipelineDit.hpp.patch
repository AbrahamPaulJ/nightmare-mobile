+  VideoResult generateVideo(const VideoRequest &req,
+                            const ProgressCallback &progress_callback,
+                            const FrameSink &sink) {
+    if (!ctx_ || !api_) throw std::runtime_error("DiT engine not initialized");
+    if (!supportsVideo())
+      throw std::invalid_argument("this model does not make videos");
+    if (req.prompt.empty()) throw std::invalid_argument("Prompt empty");
+    if (!req.start_rgb.empty() &&
+        req.start_rgb.size() !=
+            static_cast<size_t>(req.width) * req.height * 3)
+      throw std::invalid_argument("start image is not width x height");
+
+    api_->set_preview_interval(ctx_, req.preview_stride);
+
+    dit_video_params params{};
+    params.prompt = req.prompt.c_str();
+    params.negative_prompt = req.negative_prompt.c_str();
+    params.width = req.width;
+    params.height = req.height;
+    params.frames = req.frames;
+    params.fps = req.fps;
+    params.steps = req.steps;
+    params.cfg_scale = req.cfg;
+    params.flow_shift = req.flow_shift;
+    params.seed = static_cast<int64_t>(req.seed);
+    params.sample_method = req.sample_method.c_str();
+    if (req.sigmas.size() > 1) {
+      params.sigmas = req.sigmas.data();
+      params.sigma_count = static_cast<int>(req.sigmas.size());
+    }
+    if (!req.start_rgb.empty()) {
+      params.start_image_rgb = req.start_rgb.data();
+      params.start_width = req.width;
+      params.start_height = req.height;
+    }
+    params.temporal_tiling = req.temporal_tiling;
+    params.tiling_args = req.tiling_args.c_str();
+    std::vector<const char *> lora_paths;
+    std::vector<float> lora_multipliers;
+    for (const auto &lora : req.loras) {
+      lora_paths.push_back(lora.path.c_str());
+      lora_multipliers.push_back(lora.multiplier);
+    }
+    if (!lora_paths.empty()) {
+      params.lora_paths = lora_paths.data();
+      params.lora_multipliers = lora_multipliers.data();
+      params.lora_count = static_cast<int>(lora_paths.size());
+    }
+
+    VideoCallbacks callbacks;
+    callbacks.progress = &progress_callback;
+    callbacks.sink = &sink;
+    callbacks.preview_format = req.preview_format;
+    callbacks.sample_steps = req.sigmas.size() > 1
+                                 ? static_cast<int>(req.sigmas.size()) - 1
+                                 : std::max(1, req.steps);
+    QNN_INFO("[dit] video %dx%dx%d fps=%d steps=%d %s", req.width, req.height,
+             req.frames, req.fps, callbacks.sample_steps,
+             req.start_rgb.empty() ? "t2v" : "i2v");
+    const auto start = std::chrono::high_resolution_clock::now();
+    const bool ok = api_->generate_video(
+        ctx_, &params, &PipelineDit::forwardVideoProgress,
+        &PipelineDit::forwardVideoPreview, &PipelineDit::forwardVideoFrame,
+        &callbacks);
+    if (!ok) {
+      if (callbacks.pending) std::rethrow_exception(callbacks.pending);
+      throw std::runtime_error(std::string("video generation failed: ") +
+                               api_->last_error(ctx_));
+    }
+    VideoResult result;
+    result.frames = callbacks.frames;
+    result.width = callbacks.width;
+    result.height = callbacks.height;
+    result.generation_time_ms = static_cast<int>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::high_resolution_clock::now() - start)
+            .count());
+    result.first_step_time_ms = callbacks.first_step_ms;
+    return result;
+  }
 
