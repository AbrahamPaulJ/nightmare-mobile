+#ifndef PIPELINESD15INPAINT_HPP
+#define PIPELINESD15INPAINT_HPP
+
+#include <algorithm>
+#include <iostream>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "Config.hpp"
+#include "PipelineSd15Npu.hpp"
+
+// sd15npu_inpaint: a true SD1.5-*inpainting* checkpoint on the NPU.
+//
+// The only architectural difference from sd15npu is the UNet's first conv:
+// an inpainting checkpoint takes 9 input channels
+//
+//     [ noisy latent 4 | mask 1 | masked-image latent 4 ]
+//
+// instead of 4, so the model can *see* the hole it is filling and the pixels
+// surrounding it. That is what the existing mask support cannot do: blending
+// the original back in each step (Pipeline.hpp, `req.has_mask`) never tells the
+// UNet a mask exists, so the fill is effectively a txt2img sample clipped to
+// the mask silhouette -- which is why it cannot remove objects or match
+// context. Here the conditioning is part of the model input.
+//
+// Everything else -- MNN CLIP, VAE encoder/decoder, scheduler, CFG, previews,
+// resolution patches -- is inherited unchanged from PipelineSd15Npu.
+//
+// The extra channels are assembled here rather than in Pipeline::generate() so
+// the shared denoising loop keeps operating purely on 4-channel latents; this
+// pipeline widens the tensor only at the moment it calls the graph.
+class PipelineSd15Inpaint : public PipelineSd15Npu {
+ public:
+  using PipelineSd15Npu::PipelineSd15Npu;
+
+  bool isInpaintModel() const override { return true; }
+
+ protected:
+  // Build the two conditioning planes once per request, before the loop.
+  void beginDenoise(const GenerationRequest &req) override {
+    PipelineSd15Npu::beginDenoise(req);
+    prepareInpaintConditioning(req);
+  }
+
+  void endDenoise() override {
+    PipelineSd15Npu::endDenoise();
+    // ~5 MB of scratch at 512; not worth holding between requests.
+    mask_lat_.clear();
+    mask_lat_.shrink_to_fit();
+    masked_lat_.clear();
+    masked_lat_.shrink_to_fit();
+    unet_in_.clear();
+    unet_in_.shrink_to_fit();
+  }
+
+  void runUnetStep(const GenerationRequest &req, const float *latents_batch2,
+                   float timestep, bool skip_uncond, Conditioning &cond,
+                   float *out_batch2) override {
+    if (!unet_) throw std::runtime_error("QNN UNET missing");
+    if (mask_lat_.empty() || masked_lat_.empty())
+      throw std::runtime_error("inpaint conditioning not prepared");
+
+    const size_t plane = (size_t)sample_width * sample_height;
+    const size_t latent_size = 4 * plane;  // UNet *output* is always 4-ch
+    const int ts = static_cast<int>(timestep);
+
+    // Uncond half first, matching PipelineSd15Npu's ordering, so out_batch2
+    // keeps the [negative, positive] layout the CFG combine expects.
+    if (!skip_uncond) {
+      buildUnetInput(latents_batch2);
+      if (StatusCode::SUCCESS !=
+          unet_->executeUnetGraphs(unet_in_.data(), ts, cond.negHidden(),
+                                   out_batch2, kInpaintUnetInChannels))
+        throw std::runtime_error("QNN UNET exec failed (uncond)");
+    }
+
+    buildUnetInput(latents_batch2 + latent_size);
+    if (StatusCode::SUCCESS !=
+        unet_->executeUnetGraphs(unet_in_.data(), ts, cond.posHidden(),
+                                 out_batch2 + latent_size,
+                                 kInpaintUnetInChannels))
+      throw std::runtime_error("QNN UNET exec failed (cond)");
+  }
+
+  // Without a mask the whole frame is repainted (prepareInpaintConditioning),
+  // so txt2img and img2img work too; img2img stays gated on the VAE encoder
+  // exactly as in the base class (inherited).
+
+  // protected, not private: PipelineControlNetInpaint reuses the conditioning
+  // and the 9-channel assembly verbatim and only replaces the graph call.
+  static constexpr int kInpaintUnetInChannels = 9;
+
+  // Concatenate [latent 4 | mask 1 | masked latent 4] into the scratch buffer.
+  // The two conditioning planes come from PipelineSd15Npu::
+  // prepareInpaintConditioning, which the Swap v3 template shares (patch 017).
+  void buildUnetInput(const float *latent_4ch) {
+    const size_t plane = (size_t)sample_width * sample_height;
+    unet_in_.resize(kInpaintUnetInChannels * plane);
+    float *p = unet_in_.data();
+    std::copy(latent_4ch, latent_4ch + 4 * plane, p);
+    std::copy(mask_lat_.begin(), mask_lat_.end(), p + 4 * plane);
+    std::copy(masked_lat_.begin(), masked_lat_.end(), p + 5 * plane);
+  }
+
+ protected:
+  std::vector<float> unet_in_;     // scratch [1,9,h,w]
+};
+
+#endif  // PIPELINESD15INPAINT_HPP
