+    // Full-frame VAE scratch grows with pixel AREA; tile once past the point
+    // where it stops fitting. Two corrections to the obvious test, both paid
+    // for by an OOM on 2026-09-20 (a 1024x1024 edit with one 1024x1024
+    // reference reaped the app as foreground TOP):
+    //
+    //  - the request may make SEVERAL VAE passes, not one. A reference is
+    //    encoded, the init latent is encoded, and the result is decoded; an
+    //    edit from a base is three passes plus the decode. The old test was
+    //    tuned for a single full-frame decode, so a 1024x1024 edit sat under
+    //    the threshold and took 1536 MB of VRAM and 524 MB of RAM per pass.
+    //    Measured: 288 MB at 512x512, 1536 MB at 1024x1024.
+    //
+    //  - a REFERENCE is encoded at its own size, which the output resolution
+    //    says nothing about. Testing req.width * req.height only meant a
+    //    2048x2048 reference under a 512x512 canvas was never tiled.
+    const long out_pixels = static_cast<long>(req.width) * req.height;
+    // One pass per reference, one for the init latent, one for the decode.
+    const size_t vae_passes = reference_ptrs.size() +
+                              (params.init_image_rgb != nullptr ? 1u : 0u) + 1u;
+    // The largest single image any pass will put through the VAE.
+    long widest = out_pixels;
+    for (size_t i = 0; i < reference_ptrs.size(); ++i) {
+      widest = std::max(
+          widest, static_cast<long>(reference_widths[i]) * reference_heights[i]);
+    }
+    const long budget =
+        vae_passes > 1 ? kTileAbovePixelsMultiPass : kTileAbovePixels;
+    const bool tiled = vae_tile_size_ > 0 && widest > budget;
+    if (tiled) {
       params.vae_tile_size = vae_tile_size_;
       params.vae_tile_overlap = 0.25f;
     }
+    // ⚠⚠ Says the decision out loud. The buffer sizes in the log are the
+    // only other evidence of it, and reading "1536 MB" tells you nothing about
+    // WHY — whether the test was not met, the knob was zero, or the engine
+    // ignored it. One line here settles which, and this file has already cost
+    // a day to theories that a log line would have ended.
+    QNN_INFO("[dit] vae: passes=%zu widest=%ldpx budget=%ldpx tile_size=%d -> %s",
+             vae_passes, widest, budget, vae_tile_size_,
+             tiled ? "TILED" : "full-frame");
 
