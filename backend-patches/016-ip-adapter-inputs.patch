+  // <ip_dir>/{pos,neg}/<name>.raw, loaded once per directory; "" = zeros
+  // (the identity). Throws naming the file that is missing or the wrong size.
+  void loadIp(const std::string &dir) {
+    if (ip_loaded_ && dir == ip_dir_) return;
+    ip_pos_.assign(ip_inputs_.size(), {});
+    ip_neg_.assign(ip_inputs_.size(), {});
+    for (size_t i = 0; i < ip_inputs_.size(); ++i) {
+      const auto &in = ip_inputs_[i];
+      for (int side = 0; side < 2; ++side) {
+        auto &buf = side ? ip_pos_[i] : ip_neg_[i];
+        buf.assign(in.second, 0.0f);
+        if (dir.empty()) continue;
+        const std::string path =
+            dir + (side ? "/pos/" : "/neg/") + in.first + ".raw";
+        std::ifstream f(path, std::ios::binary);
+        if (!f) throw std::invalid_argument("'ip_dir': missing " + path);
+        f.read(reinterpret_cast<char *>(buf.data()), in.second * sizeof(float));
+        if (static_cast<size_t>(f.gcount()) != in.second * sizeof(float))
+          throw std::invalid_argument("'ip_dir': " + path + " holds " +
+                                      std::to_string(f.gcount()) +
+                                      " bytes, the graph wants " +
+                                      std::to_string(in.second * 4));
+      }
+    }
+    ip_dir_ = dir;
+    ip_loaded_ = true;
+    ip_bound_ = -1;
+    QNN_INFO("ip-adapter inputs: %s", dir.empty() ? "none" : dir.c_str());
+  }
+  // side 0 = uncond (neg), 1 = cond (pos); a no-op when already bound, and
+  // with no ip_dir both sides are zeros, so the first bind is the last.
+  void bindIp(const std::vector<std::vector<float>> &set, int side) {
+    if (ip_inputs_.empty() || ip_bound_ == side ||
+        (ip_dir_.empty() && ip_bound_ >= 0))
+      return;
+    for (size_t i = 0; i < ip_inputs_.size(); ++i)
+      unet_->setExtraInput(ip_inputs_[i].first, set[i]);
+    ip_bound_ = side;
+  }
+
