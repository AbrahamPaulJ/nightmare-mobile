+inline std::unique_ptr<Scheduler> createScheduler(
+    const std::string &scheduler_type, const char *timestep_spacing) {
+  auto ends = [&](const std::string &suffix) {
+    return scheduler_type.size() > suffix.size() &&
+           scheduler_type.compare(scheduler_type.size() - suffix.size(),
+                                  suffix.size(), suffix) == 0;
+  };
+  std::string base = scheduler_type;
+  bool karras = false, exponential = false;
+  if (ends("_karras")) {
+    karras = true;
+    base = scheduler_type.substr(0, scheduler_type.size() - 7);
+  } else if (ends("_exponential")) {
+    exponential = true;
+    base = scheduler_type.substr(0, scheduler_type.size() - 12);
+  }
+  auto s = createSchedulerBase(base, karras, timestep_spacing);
+  if (exponential) s->set_exponential_sigmas(true);
+  return s;
 }
 
