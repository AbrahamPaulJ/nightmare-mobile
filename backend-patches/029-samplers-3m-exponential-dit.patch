+// nightmare (029): diffusers' _convert_to_exponential — exp(linspace(log
+// sigma_max, log sigma_min, n)) over a DESCENDING sigma list, the same input
+// the Karras converters take. 'Exponential' is what turbo / hyper SDXL
+// checkpoints recommend.
+#include <cmath>
+#include <vector>
+inline std::vector<float> exponential_sigmas_vec(const std::vector<float> &in_desc,
+                                                int n) {
+  std::vector<float> out(n);
+  const double hi = std::log(double(in_desc.front()));
+  const double lo = std::log(double(in_desc.back()));
+  for (int i = 0; i < n; ++i) {
+    double t = n == 1 ? 0.0 : double(i) / double(n - 1);
+    out[i] = float(std::exp(hi + (lo - hi) * t));
+  }
+  return out;
+}
