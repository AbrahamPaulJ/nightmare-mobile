+// nightmare (054): an imported ESRGAN (a .pth / .safetensors) upscales through the DiT engine's ABI 111
+// upscale(), from ANY process: the engine file, and whether this process runs a DiT (then the NPU is
+// the engine's own; a QNN pipeline's process keeps it on the CPU, never a second NPU session beside it).
+static std::string g_dit_engine_path;
+static bool g_dit_process = false;
+
+static std::vector<uint8_t> ggmlUpscale(const std::vector<uint8_t> &rgb, int w, int h,
+                                        const std::string &model, const std::string &device,
+                                        int *out_w, int *out_h, int *factor) {
+  // ⚠ Never dlclose: in a DiT process this is the handle PipelineDit holds.
+  void *handle = dlopen(g_dit_engine_path.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (!handle) throw std::runtime_error(std::string("cannot load the DiT engine: ") + dlerror());
+  auto get_api = reinterpret_cast<dit_engine_get_api_fn>(dlsym(handle, "dit_engine_get_api"));
+  const dit_engine_api *api = get_api ? get_api(DIT_ENGINE_ABI_VERSION) : nullptr;
+  if (!api || !api->upscale)
+    throw std::runtime_error("the installed DiT engine has no upscaler (needs ABI " +
+                             std::to_string(DIT_ENGINE_ABI_VERSION) + ")");
+  dit_upscale_params p{};
+  p.model_path = model.c_str();
+  p.backend = device.c_str();
+  p.n_threads = 4;
+  p.tile_size = 128;  // sd-cli's default: 0 left the whole picture as one graph (5.3 GB on the CPU, 1024^2 x4)
+  p.rgb = rgb.data();
+  p.width = w;
+  p.height = h;
+  uint8_t *out = nullptr;
+  int ow = 0, oh = 0, f = 0;
+  if (!api->upscale(&p, &out, &ow, &oh, &f) || !out)
+    throw std::runtime_error(std::string("upscale failed: ") + api->last_error(nullptr));
+  std::vector<uint8_t> v(out, out + static_cast<size_t>(ow) * oh * 3);
+  api->free_image(out);
+  *out_w = ow;
+  *out_h = oh;
+  *factor = f;
+  return v;
+}
