+  // ⚠ Inside the `features` ARRAY only (023): 020 searched for the name
+  // anywhere after "features", and npuforge's schema-2 manifest carries a
+  // `detail` object keyed by feature name (it keeps `features` last so 020
+  // still reads it right; this no longer depends on that).
+  static bool readSwapFeature(const std::string &model_dir, const char *name) {
     std::ifstream f(std::filesystem::path(model_dir) / "swap_features.json");
     if (!f) return false;
     const std::string s((std::istreambuf_iterator<char>(f)),
                         std::istreambuf_iterator<char>());
-    const size_t at = s.find("\"features\"");
