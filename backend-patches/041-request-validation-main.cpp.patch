 static std::map<std::string, LatentHandle> g_latent_handles;
 
+// nightmare (041): the two tables are BOUNDED. Nothing ever erased from them, so every distinct
+// prompt pair added a cond (7.5 MB on SDXL's 462-token context) and every seed a latent, and a
+// long session of prompt tweaks grew the backend by GBs until lmkd took it. Least recently USED
+// goes first once the pair passes kHandleCapBytes; a lookup counts as a use, so a cond reused
+// across a batch stays, and the handle just registered is never the one evicted. ⚠ Safe for the
+// app: the executor asks GET /handles before trusting a cached handle and recomputes what is gone.
+static constexpr size_t kHandleCapBytes = (size_t)512 << 20;
+static std::map<std::string, uint64_t> g_handle_used;
+static uint64_t g_handle_clock = 0;
+
+static size_t handleBytes(const Conditioning &c) {
+  return (c.hidden.size() + c.pooled.size() + c.time_ids.size()) * sizeof(float);
+}
+static size_t handleBytes(const LatentHandle &l) { return l.data.size() * sizeof(float); }
+
+// ⚠ The caller holds g_handle_mutex.
+static void touchHandle(const std::string &h) { g_handle_used[h] = ++g_handle_clock; }
+
+// ⚠ The caller holds g_handle_mutex. [keep] = the handle just registered.
+static void evictHandles(const std::string &keep) {
+  size_t total = 0;
+  for (const auto &kv : g_cond_handles) total += handleBytes(kv.second);
+  for (const auto &kv : g_latent_handles) total += handleBytes(kv.second);
+  while (total > kHandleCapBytes) {
+    std::string oldest;
+    uint64_t best = std::numeric_limits<uint64_t>::max();
+    auto consider = [&](const std::string &h) {
+      if (h == keep) return;
+      auto it = g_handle_used.find(h);
+      const uint64_t t = it == g_handle_used.end() ? 0 : it->second;
+      if (t < best) { best = t; oldest = h; }
+    };
+    for (const auto &kv : g_cond_handles) consider(kv.first);
+    for (const auto &kv : g_latent_handles) consider(kv.first);
+    if (oldest.empty()) break;
+    if (auto c = g_cond_handles.find(oldest); c != g_cond_handles.end()) {
+      total -= handleBytes(c->second);
+      g_cond_handles.erase(c);
+    } else if (auto l = g_latent_handles.find(oldest); l != g_latent_handles.end()) {
+      total -= handleBytes(l->second);
+      g_latent_handles.erase(l);
+    }
+    g_handle_used.erase(oldest);
+  }
+}
