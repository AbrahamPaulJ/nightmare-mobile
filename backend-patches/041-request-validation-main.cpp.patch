+// nightmare (041): a size from a request body is checked before anything is allocated from it.
+// 0 sized an empty buffer the graph then wrote into, a negative one wrapped `(size_t)3*w*h`, and
+// a size off the 8 grid or past the graph is refused by name (QnnModel's vaeCountsMatch catches a
+// size the VAE was not built for; this catches the nonsense ones first).
+static void requireOpSize(int width, int height) {
+  if (width <= 0 || height <= 0 || width > 4096 || height > 4096 || width % 8 != 0 ||
+      height % 8 != 0)
+    throw std::invalid_argument("width and height must be multiples of 8 between 8 and 4096, got " +
+                                std::to_string(width) + "x" + std::to_string(height));
+}
