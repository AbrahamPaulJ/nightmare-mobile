+  // Set once a ControlNet only fitted with the VAEs released (loadControlNet).
+  bool vae_tight_ = false;
+
+  void releaseVaes() {
+    vae_decoder_.reset();
+    vae_encoder_.reset();
+  }
+
+  // Reload one VAE in tight mode; the ControlNet makes room if it has to, and
+  // the next ControlNet step loads it again.
+  void ensureVae(std::unique_ptr<QnnModel> &model, const std::string &path,
+                 const char *name, const char *app) {
+    if (model || path.empty()) return;
+    auto load = [&]() {
+      model = qnn_runtime::createModel(path, name);
+      if (!model || qnn_runtime::initializeApp(app, model) != EXIT_SUCCESS) {
+        model.reset();
+        return false;
+      }
+      return true;
+    };
+    if (load()) return;
+    if (tpl_controlnet_) {
+      QNN_WARN("%s did not fit beside the controlnet: releasing it", app);
+      tpl_controlnet_.reset();
+      tpl_controlnet_path_.clear();
+      if (load()) return;
+    }
+    throw std::runtime_error(std::string("Failed to reload ") + app);
+  }
 
