+inline void Pipeline::encodePixelsToLatentStats(
+    const GenerationRequest &req, const xt::xarray<float> &pixels_nchw,
+    std::vector<float> &out_mean, std::vector<float> &out_std) {
+  const int latent_ch = latentChannels();
+  const size_t plane = (size_t)sample_width * sample_height;
+  out_mean.assign(latent_ch * plane, 0.0f);
+  out_std.assign(latent_ch * plane, 0.0f);
+
+  if (!useTiledVae(req)) {
+    // Fits the graph: one pass at the current global IO dimensions.
+    vaeEncode(req, pixels_nchw.data(), out_mean.data(), out_std.data());
+    return;
+  }
+
+  std::cout << "Using VAE encoder tiling for " << req.width << "x" << req.height
+            << " input (latent stats)..." << std::endl;
+
+  const int tile_px = vaeTilePixelSize();
+  const int tile_lat = tile_px / 8;
+
+  auto [img_positions, latent_positions, img_overlap_x, img_overlap_y,
+        latent_overlap_x, latent_overlap_y] =
+      calculate_vae_tile_positions(req.width, req.height, tile_px);
+
+  std::vector<std::pair<xt::xarray<float>, xt::xarray<float>>> tiles;
+  tiles.reserve(img_positions.size());
+
+  {
+    // The encoder graph's IO size is read from the Config.hpp globals, so they
+    // must read as one tile for the duration of the tile passes. This is the
+    // step the direct vaeEncode() call was missing.
+    ScopedSizeOverride tile_io(tile_px, tile_px, tile_lat, tile_lat);
+
+    for (size_t i = 0; i < img_positions.size(); ++i) {
+      auto pos = img_positions[i];
+      xt::xarray<float> img_tile =
+          xt::view(pixels_nchw, 0, xt::all(),
+                   xt::range(pos.second, pos.second + tile_px),
+                   xt::range(pos.first, pos.first + tile_px));
+
+      std::vector<float> tile_vec(img_tile.begin(), img_tile.end());
+      // 4, not latentChannels(): blend_vae_encoder_tile_stats accumulates a
+      // fixed 4-channel plane, and the tiled path is QNN-4-channel only
+      // (Anima is 16-channel but never tiles). Matches the img2img tiled path.
+      std::vector<float> tile_mean(1 * 4 * tile_lat * tile_lat);
+      std::vector<float> tile_std(1 * 4 * tile_lat * tile_lat);
+
+      vaeEncode(req, tile_vec.data(), tile_mean.data(), tile_std.data());
+
+      std::vector<int> tile_shape = {1, 4, tile_lat, tile_lat};
+      tiles.push_back(
+          {xt::adapt(tile_mean, tile_shape), xt::adapt(tile_std, tile_shape)});
+    }
+  }
+
+  auto [mean, std_dev] = blend_vae_encoder_tile_stats(
+      tiles, latent_positions, sample_height, sample_width, tile_lat,
+      latent_overlap_x, latent_overlap_y);
+
+  out_mean.assign(mean.begin(), mean.end());
+  out_std.assign(std_dev.begin(), std_dev.end());
+
+  std::cout << "VAE encoder tiling completed: " << tiles.size()
+            << " tiles blended into latent stats" << std::endl;
+}
