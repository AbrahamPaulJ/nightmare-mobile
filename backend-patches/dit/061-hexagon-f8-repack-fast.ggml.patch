+// nightmare (dit/061): the aligned fp8 repack a 32-bit word at a time, threaded over column tiles. A
+// streamed DiT re-uploads its weights every step, and the byte loop below (one thread, under the
+// loader's tensor_set mutex) ran at ~0.8 GB/s: Z-Image at a 4 GiB budget spent ~4.5 s a step in it.
+// Same bytes out: tile row 4*g + r/8 holds, for r%8 = 0..7, source row r's k-values 4g..4g+3 in
+// lane order 0, 2, 1, 3, with 0x80 (negative zero) stored as 0.
+static inline uint32_t f8_e4m3_tile_word(uint32_t w) {
+    w = (w & 0xff0000ffu) | ((w & 0x0000ff00u) << 8) | ((w & 0x00ff0000u) >> 8);
+    const uint32_t y = w ^ 0x80808080u;  // a byte that was 0x80 is now 0
+    const uint32_t z = ~(((y & 0x7f7f7f7fu) + 0x7f7f7f7fu) | y | 0x7f7f7f7fu);  // 0x80 in each zero byte
+    return w & ~((z >> 7) * 0xffu);
+}
+
+static bool repack_f8_e4m3_tiled_fast(ggml_tensor * t, const void * data) {
+    const int64_t ne0 = t->ne[0];
+    const int64_t ne1 = t->ne[1];
+    if (ne0 % 32 != 0 || ne1 % 32 != 0 || getenv("NM_F8_REPACK_SLOW") != nullptr) {
+        return false;
+    }
+    const int64_t n_mat = t->ne[2] * t->ne[3];
+    const int n_k_tiles = (int) (ne0 / 32);
+    const int n_col_tiles = (int) (ne1 / 32);
+    const int64_t n_jobs = n_mat * n_col_tiles;
+    auto run = [&](int64_t j0, int64_t j1) {
+        for (int64_t job = j0; job < j1; ++job) {
+            const int64_t m = job / n_col_tiles;
+            const int ct = (int) (job % n_col_tiles);
+            const uint8_t * mat_src = (const uint8_t *) data + m * ne1 * ne0;
+            uint8_t * col_dst = (uint8_t *) t->data +
+                ((size_t) m * n_col_tiles + ct) * n_k_tiles * HTP_MM_WEIGHT_TILE_SIZE_F8_E4M3;
+            for (int kt = 0; kt < n_k_tiles; ++kt) {
+                uint32_t * tile = (uint32_t *) (col_dst + (size_t) kt * HTP_MM_WEIGHT_TILE_SIZE_F8_E4M3);
+                for (int tr = 0; tr < 32; ++tr) {
+                    const int g = tr / 4;
+                    const int r0 = (tr % 4) * 8;
+                    for (int q = 0; q < 8; ++q) {
+                        uint32_t w;
+                        memcpy(&w, mat_src + ((int64_t) ct * 32 + r0 + q) * ne0 + (int64_t) kt * 32 + 4 * g, 4);
+                        tile[tr * 8 + q] = f8_e4m3_tile_word(w);
+                    }
+                }
+            }
+        }
+    };
+    const int64_t n_threads = std::min<int64_t>(std::max(1u, std::thread::hardware_concurrency()),
+                                                std::max<int64_t>(1, ggml_nbytes(t) >> 20));
+    if (n_threads <= 1) {
+        run(0, n_jobs);
+        return true;
+    }
+    std::vector<std::thread> workers;
+    for (int64_t i = 0; i < n_threads; ++i) {
+        workers.emplace_back(run, n_jobs * i / n_threads, n_jobs * (i + 1) / n_threads);
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+    return true;
+}
