+                int layers              = 0;
+                const auto layer_prefix = prefix + ".decoder.transformer_blocks.";
+                for (const auto& [name, _] : tensors) {
+                    if (starts_with(name, layer_prefix)) {
+                        layers = std::max(layers, std::atoi(name.c_str() + layer_prefix.size()) + 1);
+                    }
+                }
+                if (layers > 0) {
+                    config.num_layers = layers;
+                }
+            }
+            config.vit_decoder_2d = config.patch_size_t == 1 && config.hidden_size == 1024;
+            if (proj != tensors.end()) {
+                LOG_VERBOSE("minimax_h3_vae: layers=%d, patch_size_t=%d, hidden_size=%d",
+                            config.num_layers,
+                            config.patch_size_t,
+                            config.hidden_size);
+            }
+            return config;
+        }
