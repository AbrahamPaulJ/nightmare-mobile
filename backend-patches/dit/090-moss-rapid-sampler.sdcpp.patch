+// nightmare (dit/090): rapid-moss's dataspace.safetensors: latent_mix.Q [128, 128] and step_codes [4].
+static bool read_moss_rapid(const std::string& dir, std::vector<float>& q, std::vector<float>& codes) {
+    std::ifstream f(dir + "/dataspace.safetensors", std::ios::binary);
+    uint64_t header_bytes = 0;
+    if (!f.read(reinterpret_cast<char*>(&header_bytes), sizeof(header_bytes)) || header_bytes > (1u << 20)) {
+        return false;
+    }
+    std::string header(header_bytes, '\0');
+    if (!f.read(header.data(), static_cast<std::streamsize>(header_bytes))) {
+        return false;
+    }
+    const auto j = nlohmann::json::parse(header, nullptr, false);
+    if (j.is_discarded()) {
+        return false;
+    }
+    auto read = [&](const char* name, std::vector<float>& to, size_t count) {
+        if (!j.contains(name)) {
+            return false;
+        }
+        const size_t begin = j[name]["data_offsets"][0].get<size_t>();
+        const size_t end   = j[name]["data_offsets"][1].get<size_t>();
+        if (end - begin != count * sizeof(float)) {
+            return false;
+        }
+        to.resize(count);
+        f.clear();
+        f.seekg(static_cast<std::streamoff>(sizeof(header_bytes) + header_bytes + begin));
+        return static_cast<bool>(f.read(reinterpret_cast<char*>(to.data()), static_cast<std::streamsize>(end - begin)));
+    };
+    return read("latent_mix.Q", q, 128 * 128) && read("step_codes", codes, 4);
 }
 
