+                    said = true;
+                }
+                if (ok) {
+                    Br = oBr;
+                    Bc = oBc;
+                }
+            }
+        }
         if (ret == 0) {
             kparams->kernel_type = HTP_FA_KERNEL_HMX;
             kparams->Br = Br;
