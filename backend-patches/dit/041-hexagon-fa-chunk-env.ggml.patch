+                const bool   ok      = oBr % br_unit == 0 && oBc % 64 == 0 && need <= sess->vtcm_size;
+                if (!said) {
+                    GGML_LOG_INFO("ggml-hex: FA chunk %zux%zu (search %zux%zu, %zu bytes of %zu VTCM) %s\n", oBr, oBc, Br, Bc,
