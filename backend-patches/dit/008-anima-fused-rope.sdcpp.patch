+    // q/k RMSNorm that can take the backend's fused qknorm+rope op. Anima's rope is
+    // rotate-half (pairs j, j+D/2) and the fused kernel is interleaved (pairs 2j, 2j+1),
+    // so x and the norm weight are reordered j -> 2j, j+D/2 -> 2j+1 first. q and k get the
+    // same reordering, which leaves q.k -- the only thing attention reads -- unchanged.
+    class AnimaQKNorm : public RMSNorm {
+    public:
+        using RMSNorm::RMSNorm;
+
+        ggml_tensor* try_forward_rope_half(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* theta) {
+            if (ctx->backend == nullptr || x->ne[0] % 2 != 0) {
+                return nullptr;
+            }
+            ggml_tensor* w = params["weight"];
+            if (ctx->weight_adapter) {
+                w = ctx->weight_adapter->patch_weight(ctx->ggml_ctx, ctx->backend, w, prefix + "weight");
+            }
+            const int64_t d    = x->ne[0];
+            auto interleave    = [&](ggml_tensor* t, int64_t rows) {
+                t = ggml_reshape_3d(ctx->ggml_ctx, t, d / 2, 2, rows);                  // [rows, 2, d/2]
+                return ggml_cont(ctx->ggml_ctx, ggml_permute(ctx->ggml_ctx, t, 1, 0, 2, 3));  // [rows, d/2, 2]
+            };
+            auto xi            = ggml_reshape_4d(ctx->ggml_ctx, interleave(x, x->ne[1] * x->ne[2] * x->ne[3]),
+                                                 d, x->ne[1], x->ne[2], x->ne[3]);
+            auto wi            = ggml_reshape_1d(ctx->ggml_ctx, interleave(w, 1), d);
+            ggml_tensor* out   = ggml_qknorm_rope(ctx->ggml_ctx, xi, wi, theta, eps);
+            return ggml_backend_supports_op(ctx->backend, out) ? out : nullptr;
+        }
+    };
+
