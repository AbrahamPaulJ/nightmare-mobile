+// nightmare (ABI 109): FlashVSR 2x video upscaling (stable-diffusion.cpp dit/058).
+struct VsrRun {
+  dit_progress_cb progress = nullptr;
+  void *user_data = nullptr;
+  flashvsr_ctx_t *fv = nullptr;
+  bool cancelled = false;
+};
+VsrRun g_vsr_run;
+
+void forward_vsr_progress(int step, int steps, float time, void *) {
+  if (g_vsr_run.progress && !g_vsr_run.progress(step, steps, time, g_vsr_run.user_data)) {
+    g_vsr_run.cancelled = true;
+    flashvsr_cancel(g_vsr_run.fv);
+  }
+}
+
+dit_vsr *vsr_create(const char *model_path, const char *backend, const char *params_backend, int n_threads) {
+  g_create_error.clear();
+  if (!model_path || !model_path[0]) {
+    g_create_error = "missing model path";
+    return nullptr;
+  }
+  flashvsr_ctx_t *fv = new_flashvsr_ctx(model_path, n_threads > 0 ? n_threads : 4, backend, params_backend);
+  if (!fv) {
+    g_create_error = "new_flashvsr_ctx failed";
+    return nullptr;
+  }
+  auto *vsr = new dit_vsr();
+  vsr->fv = fv;
+  return vsr;
+}
+
+void vsr_destroy(dit_vsr *vsr) {
+  if (!vsr) return;
+  if (vsr->fv) free_flashvsr_ctx(vsr->fv);
+  delete vsr;
+}
+
+bool vsr_upscale(dit_vsr *vsr, const uint8_t *rgb, int count, int width, int height, int tile, int overlap,
+                 int64_t seed, dit_progress_cb progress, dit_frame_cb on_frame, void *user_data) {
+  if (!vsr || !vsr->fv || !rgb || count < 1 || width < 1 || height < 1 || !on_frame) return false;
+  vsr->last_error.clear();
+  std::lock_guard<std::mutex> lock(g_gen_mutex);
+  const size_t frame_bytes = static_cast<size_t>(width) * static_cast<size_t>(height) * 3;
+  std::vector<sd_image_t> in(static_cast<size_t>(count));
+  for (int i = 0; i < count; ++i)
+    in[i] = {static_cast<uint32_t>(width), static_cast<uint32_t>(height), 3,
+             const_cast<uint8_t *>(rgb) + frame_bytes * static_cast<size_t>(i)};
+  g_vsr_run = VsrRun{progress, user_data, vsr->fv, false};
+  sd_set_progress_callback(forward_vsr_progress, nullptr);
+  sd_image_t *out = nullptr;
+  const bool ok = flashvsr_upscale(vsr->fv, in.data(), count, tile, overlap, seed, &out);
+  sd_set_progress_callback(nullptr, nullptr);
+  const bool cancelled = g_vsr_run.cancelled;
+  g_vsr_run = VsrRun{};
+  if (!ok || !out) {
+    vsr->last_error = cancelled ? "cancelled" : "flashvsr_upscale failed";
+    return false;
+  }
+  bool delivered = true;
+  for (int i = 0; i < count && delivered; ++i) {
+    if (!on_frame(i, count, out[i].data, static_cast<int>(out[i].width), static_cast<int>(out[i].height), user_data)) {
+      vsr->last_error = "frame delivery stopped";
+      delivered = false;
+    }
+  }
+  free_sd_images(out, count);
+  return delivered;
+}
+
+const char *vsr_last_error(const dit_vsr *vsr) {
+  if (!vsr) return g_create_error.c_str();
+  return vsr->last_error.c_str();
+}
+
 void engine_free_image(uint8_t *pixels) { free(pixels); }
 
