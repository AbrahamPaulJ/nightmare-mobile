+    vsr_create,
+    vsr_destroy,
+    vsr_upscale,
+    vsr_last_error,
 };
 
+// A 108 core reads only the prefix it knows; its abi_version field says 108.
+dit_engine_api make_api_108() {
+  dit_engine_api api = g_api;
+  api.abi_version = 108;
+  return api;
+}
+const dit_engine_api g_api_108 = make_api_108();
+
 }  // namespace
 
 extern "C" __attribute__((visibility("default"))) const dit_engine_api *dit_engine_get_api(
     int requested_abi_version) {
+  if (requested_abi_version == 108) return &g_api_108;
   if (requested_abi_version != DIT_ENGINE_ABI_VERSION) return nullptr;
   return &g_api;
 }
