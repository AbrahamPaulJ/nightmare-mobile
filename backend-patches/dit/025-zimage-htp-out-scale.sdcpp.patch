@@ -159,6 +159,16 @@ namespace ZImage {
                 out_proj->set_force_prec_f32(true);
                 qkv_proj->set_force_prec_f32(true);
             }
+            // Hexagon: the matmul result passes through fp16, and attention.out's reaches 92k (context_refiner.0)
+            // and 138k (noise_refiner.0) on Q4_0/Q8_0 GGUFs -> inf -> NaN everywhere (SD_NAN_PROBE on the S25).
+            // ROCm's 1/16 keeps it in range. SD_ZIMAGE_OUT_SCALE overrides; fp8 renders right and is left alone.
+            if (sd_backend_is(ctx->backend, "HTP") && out_proj->weight_type() != GGML_TYPE_F8_E4M3) {
+                static const float htp_out_scale = [] {
+                    const char* e = getenv("SD_ZIMAGE_OUT_SCALE");
+                    return e ? (float)atof(e) : 1.f / 16.f;
+                }();
+                out_proj->set_scale(htp_out_scale);
+            }
 
             auto qkv = qkv_proj->forward(ctx, x);                                                                            // [N, n_token, (num_heads + num_kv_heads*2)*head_dim]
             qkv      = ggml_reshape_4d(ctx->ggml_ctx, qkv, head_dim, num_heads + num_kv_heads * 2, qkv->ne[1], qkv->ne[2]);  // [N, n_token, num_heads + num_kv_heads*2, head_dim]
