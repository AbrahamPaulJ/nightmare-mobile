+#ifndef __SD_MODEL_UPSCALER_FLASHVSR_HPP__
+#define __SD_MODEL_UPSCALER_FLASHVSR_HPP__
+
+// nightmare (dit/058): FlashVSR v1.1 "tiny" (JunhaoZhuang/FlashVSR-v1.1, Apache 2.0), a one-step video upscaler: a Wan 2.1
+// 1.3B DiT that streams in time chunks with a key/value cache, fed by a causal LQ projector, decoded by TCDecoder (a
+// wider TAEHV conditioned on the pixel-shuffled LQ video). Checked against the PyTorch pipeline
+// (`../LocalDream/vsr/dump_ref.py`). One GGUF holds it all: dit.* (Wan names), lq.*, dec.decoder.*, context.
+
+#include "model/diffusion/wan.hpp"
+#include "model/vae/vae.hpp"
+#include "model/vae/tae.hpp"
+#include "model/vae/wan_vae.hpp"
+
+namespace FlashVSR {
+
+    constexpr int LQ_CHANNELS  = 3 * 16 * 16;  // PixelShuffle3d(1, 16, 16) of the LQ video, the DiT's token grid
+    constexpr int DEC_CHANNELS = 3 * 4 * 8 * 8;  // PixelShuffle3d(4, 8, 8), the decoder's latent grid
+    constexpr int LQ_LEAD      = 6;            // LQ stream frames before a chunk's first latent frame (two stride-2 convs)
+
+    // FlashVSR's CausalConv3d pads h and w by REPLICATING the edge (F.pad mode='replicate'), not with zeros.
+    static ggml_tensor* replicate_pad_hw(ggml_context* c, ggml_tensor* x) {
+        // x: [W, H, T, C]
+        auto col = [&](ggml_tensor* t, int64_t i) {
+            return ggml_cont(c, ggml_view_4d(c, t, 1, t->ne[1], t->ne[2], t->ne[3], t->nb[1], t->nb[2], t->nb[3], i * t->nb[0]));
+        };
+        auto row = [&](ggml_tensor* t, int64_t j) {
+            return ggml_cont(c, ggml_view_4d(c, t, t->ne[0], 1, t->ne[2], t->ne[3], t->nb[1], t->nb[2], t->nb[3], j * t->nb[1]));
+        };
+        x = ggml_concat(c, ggml_concat(c, col(x, 0), x, 0), col(x, x->ne[0] - 1), 0);
+        return ggml_concat(c, ggml_concat(c, row(x, 0), x, 1), row(x, x->ne[1] - 1), 1);
+    }
+
+    // Causal_LQ4x_Proj (layer_num 1). Its stream_forward over 4-frame clips with two cached frames per conv is one
+    // strided conv over a continuous stream S (S[i] = LQ frame max(0, i - 5): the first frame six times, then the rest),
+    // so latent frame k depends on S[4k, 4k + 10) and a chunk of n latent frames takes 4n + 6 stream frames, no state.
+    class LQProj : public GGMLBlock {
+    public:
+        LQProj() {
+            blocks["conv1"]           = std::shared_ptr<GGMLBlock>(new WAN::CausalConv3d(LQ_CHANNELS, 2048, {4, 3, 3}, {2, 1, 1}));
+            blocks["norm1"]           = std::shared_ptr<GGMLBlock>(new WAN::RMS_norm(2048));
+            blocks["conv2"]           = std::shared_ptr<GGMLBlock>(new WAN::CausalConv3d(2048, 3072, {4, 3, 3}, {2, 1, 1}));
+            blocks["norm2"]           = std::shared_ptr<GGMLBlock>(new WAN::RMS_norm(3072));
+            blocks["linear_layers.0"] = std::shared_ptr<GGMLBlock>(new Linear(3072, 1536));
+        }
+
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* s) {
+            // s: [w, h, 4n + 6, LQ_CHANNELS]; return [1536, n*h*w], tokens w fastest, then h, then t
+            auto gc     = ctx->ggml_ctx;
+            auto conv1  = std::dynamic_pointer_cast<WAN::CausalConv3d>(blocks["conv1"]);
+            auto conv2  = std::dynamic_pointer_cast<WAN::CausalConv3d>(blocks["conv2"]);
+            auto norm1  = std::dynamic_pointer_cast<WAN::RMS_norm>(blocks["norm1"]);
+            auto norm2  = std::dynamic_pointer_cast<WAN::RMS_norm>(blocks["norm2"]);
+            auto linear = std::dynamic_pointer_cast<Linear>(blocks["linear_layers.0"]);
+            auto h      = norm1->forward_silu(ctx, conv1->forward(ctx, replicate_pad_hw(gc, s)));  // [w, h, 2n + 2, 2048]
+            h           = norm2->forward_silu(ctx, conv2->forward(ctx, replicate_pad_hw(gc, h)));  // [w, h, n, 3072]
+            h           = ggml_reshape_2d(gc, h, h->ne[0] * h->ne[1] * h->ne[2], h->ne[3]);
+            return linear->forward(ctx, ggml_cont(gc, ggml_transpose(gc, h)));
+        }
+    };
+
+    // TCDecoder: TAEHV's decoder at channels 512/256/128/128 with 784 input channels (the pixel-shuffled LQ video, then
+    // the latent) and an extra 3x3 conv + ReLU after the two top-level ReLUs (indices 3 and 24). Runs a chunk of latent
+    // frames at a time: each MemBlock's "past" frame comes in from the previous chunk (null = zeros, the first chunk),
+    // the same as the reference's sequential decode.
+    class TCDecoder : public GGMLBlock {
+        static constexpr int channels[4] = {512, 256, 128, 128};
+
+    public:
+        static constexpr int num_mem = 9;
+
+        TCDecoder() {
+            blocks["1"]  = std::shared_ptr<GGMLBlock>(new Conv2d(DEC_CHANNELS + 16, channels[0], {3, 3}, {1, 1}, {1, 1}));
+            blocks["3"]  = std::shared_ptr<GGMLBlock>(new Conv2d(channels[0], channels[0], {3, 3}, {1, 1}, {1, 1}, {1, 1}, false));
+            int index    = 5;
+            const int st[3] = {1, 2, 2};
+            for (int i = 0; i < 3; i++) {
+                for (int j = 0; j < 3; j++) {
+                    blocks[std::to_string(index++)] = std::shared_ptr<GGMLBlock>(new MemBlock(channels[i], channels[i]));
+                }
+                index++;  // nn.Upsample
+                blocks[std::to_string(index++)] = std::shared_ptr<GGMLBlock>(new TGrow(channels[i], st[i]));
+                blocks[std::to_string(index++)] = std::shared_ptr<GGMLBlock>(new Conv2d(channels[i], channels[i + 1], {3, 3}, {1, 1}, {1, 1}, {1, 1}, false));
+            }
+            blocks["24"] = std::shared_ptr<GGMLBlock>(new Conv2d(channels[3], channels[3], {3, 3}, {1, 1}, {1, 1}, {1, 1}, false));
+            blocks["26"] = std::shared_ptr<GGMLBlock>(new Conv2d(channels[3], 3, {3, 3}, {1, 1}, {1, 1}));
+        }
+
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* z, bool first,
+                             const std::vector<ggml_tensor*>& mem_in, std::vector<ggml_tensor*>& mem_out) {
+            // z: [W, H, 784, T] (frames as the batch); return [W*8, H*8, 3, 4T] (4T - 3 on the first chunk), in ~[0, 1]
+            auto gc   = ctx->ggml_ctx;
+            auto conv = [&](const char* name, ggml_tensor* x) {
+                return std::dynamic_pointer_cast<Conv2d>(blocks[name])->forward(ctx, x);
+            };
+            auto h = ggml_ext_scale(gc, ggml_tanh_inplace(gc, ggml_ext_scale(gc, z, 1.0f / 3.0f)), 3.0f, true);  // Clamp()
+            h      = ggml_relu_inplace(gc, conv("1", h));
+            h      = ggml_relu_inplace(gc, conv("3", h));
+            mem_out.assign(num_mem, nullptr);
+            int index = 5, m = 0;
+            for (int i = 0; i < 3; i++) {
+                for (int j = 0; j < 3; j++, m++) {
+                    const int64_t T = h->ne[3];
+                    ggml_tensor* past;
+                    if (mem_in.empty() || mem_in[m] == nullptr) {
+                        past = ggml_ext_pad_ext(gc, ctx->backend, h, 0, 0, 0, 0, 0, 0, 1, 0);
+                        past = ggml_view_4d(gc, past, h->ne[0], h->ne[1], h->ne[2], T, h->nb[1], h->nb[2], h->nb[3], 0);
+                    } else if (T == 1) {
+                        past = mem_in[m];
+                    } else {
+                        past = ggml_concat(gc, mem_in[m], ggml_view_4d(gc, h, h->ne[0], h->ne[1], h->ne[2], T - 1, h->nb[1], h->nb[2], h->nb[3], 0), 3);
+                    }
+                    mem_out[m] = ggml_cont(gc, ggml_view_4d(gc, h, h->ne[0], h->ne[1], h->ne[2], 1, h->nb[1], h->nb[2], h->nb[3], (T - 1) * h->nb[3]));
+                    h          = std::dynamic_pointer_cast<MemBlock>(blocks[std::to_string(index++)])->forward(ctx, h, past);
+                }
+                index++;
+                h = ggml_upscale(gc, h, 2, GGML_SCALE_MODE_NEAREST);
+                h = std::dynamic_pointer_cast<UnaryBlock>(blocks[std::to_string(index++)])->forward(ctx, h);  // TGrow
+                h = conv(std::to_string(index++).c_str(), h);
+            }
+            h = ggml_relu_inplace(gc, h);
+            h = ggml_relu_inplace(gc, conv("24", h));
+            h = conv("26", h);
+            if (first) {
+                h = ggml_view_4d(gc, h, h->ne[0], h->ne[1], h->ne[2], h->ne[3] - 3, h->nb[1], h->nb[2], h->nb[3], 3 * h->nb[3]);
+            }
+            return h;
+        }
+    };
+
+    // The fixed prompt (FlashVSR's posi_prompt.pth: umT5 states, [4096, 512]) as a weight of the file.
+    class Prompt : public GGMLBlock {
+    protected:
+        void init_params(ggml_context* ctx, const String2TensorStorage& tensor_storage_map = {}, const std::string prefix = "") override {
+            params["context"] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4096, 512);
+        }
+
+    public:
+        ggml_tensor* context() { return params["context"]; }
+    };
+
+    // The DiT, the LQ projector and the prompt: one chunk of latent frames a call. Keys and values live in the runner
+    // cache a SLICE (two latent frames, the reference's window) at a time, in four slots: a chunk attends to the three
+    // slices before it and its own.
+    struct DiTRunner : public GGMLRunner {
+        WAN::WanConfig config;
+        WAN::Wan wan;
+        LQProj lq;
+        Prompt prompt;
+        std::vector<float> pe_vec;
+        sd::Tensor<float> timestep = sd::Tensor<float>({1}, std::vector<float>{1000.f});
+
+        DiTRunner(ggml_backend_t backend,
+                  const String2TensorStorage& tensor_storage_map      = {},
+                  std::shared_ptr<RunnerWeightManager> weight_manager = nullptr)
+            : GGMLRunner(backend, weight_manager),
+              config(WAN::WanConfig::detect_from_weights(tensor_storage_map, "dit.")) {
+            config.model_type = "t2v";
+            config.in_dim     = 16;
+            config.dim        = 1536;
+            config.ffn_dim    = 8960;
+            config.num_heads  = 12;
+            config.out_dim    = 16;
+            config.eps        = 1e-6f;
+            wan               = WAN::Wan(config);
+            wan.init(params_ctx, tensor_storage_map, "dit");
+            lq.init(params_ctx, tensor_storage_map, "lq");
+            prompt.init(params_ctx, tensor_storage_map, "");
+        }
+
+        std::string get_desc() override { return "flashvsr-dit"; }
+
+        void get_param_tensors(std::map<std::string, ggml_tensor*>& tensors) {
+            wan.get_param_tensors(tensors, "dit");
+            lq.get_param_tensors(tensors, "lq");
+            prompt.get_param_tensors(tensors, "");
+        }
+
+        static std::string kv_name(const char* kv, int layer, int64_t slice) {
+            return std::string("fvsr.") + kv + std::to_string(layer) + "." + std::to_string(slice % 4);
+        }
+
+        ggml_cgraph* build_graph(const sd::Tensor<float>& noise, const sd::Tensor<float>& stream, int64_t t_offset) {
+            // noise: [W, H, n, 16], n = 6 (the first chunk) or 2; stream: [W/2, H/2, 4n + 6, LQ_CHANNELS]
+            ggml_cgraph* gf = new_graph_custom(WAN::WAN_GRAPH_SIZE);
+            ggml_tensor* x  = make_input(noise);
+            ggml_tensor* s  = make_input(stream);
+            ggml_tensor* ts = make_input(timestep);
+            const int64_t n = noise.shape()[2];
+            pe_vec          = Rope::embed_nd(Rope::gen_vid_ids((int)n, (int)noise.shape()[1], (int)noise.shape()[0], 1, 2, 2, 1, (int)t_offset),
+                                             1, (float)config.theta, config.axes_dim);
+            auto pe         = ggml_new_tensor_4d(compute_ctx, GGML_TYPE_F32, 2, 2, config.axes_dim_sum / 2, pe_vec.size() / config.axes_dim_sum / 2);
+            set_backend_tensor_data(pe, pe_vec.data());
+
+            const int64_t slice0 = t_offset / 2, slices = n / 2;
+            std::vector<ggml_tensor*> k_past, v_past;
+            if (slice0 > 0) {
+                for (int i = 0; i < config.num_layers; i++) {
+                    ggml_tensor *k = nullptr, *v = nullptr;
+                    for (int64_t sl = std::max<int64_t>(0, slice0 - 3); sl < slice0; sl++) {
+                        auto kc = get_cache_tensor_by_name(kv_name("k", i, sl));
+                        auto vc = get_cache_tensor_by_name(kv_name("v", i, sl));
+                        GGML_ASSERT(kc != nullptr && vc != nullptr);
+                        k = k ? ggml_concat(compute_ctx, k, kc, 1) : kc;
+                        v = v ? ggml_concat(compute_ctx, v, vc, 1) : vc;
+                    }
+                    k_past.push_back(k);
+                    v_past.push_back(v);
+                }
+            }
+
+            auto runner_ctx = get_context();
+            auto tokens     = lq.forward(&runner_ctx, s);
+            std::vector<ggml_tensor*> k_out, v_out;
+            auto v_pred = wan.forward_flashvsr(&runner_ctx, x, ts, prompt.context(), pe, tokens, k_past, v_past, k_out, v_out);
+            GGML_ASSERT(v_pred != nullptr && "FlashVSR needs the fused rope and flash attention on this backend");
+            for (int i = 0; i < config.num_layers; i++) {
+                for (int kv = 0; kv < 2; kv++) {
+                    ggml_tensor* t   = kv == 0 ? k_out[i] : v_out[i];
+                    const int64_t sl = t->ne[1] / slices;
+                    for (int64_t j = 0; j < slices; j++) {
+                        ggml_tensor* part = slices == 1 ? t : ggml_cont(compute_ctx, ggml_view_3d(compute_ctx, t, t->ne[0], sl, t->ne[2], t->nb[1], t->nb[2], j * sl * t->nb[1]));
+                        cache(kv_name(kv == 0 ? "k" : "v", i, slice0 + j), part);
+                        ggml_build_forward_expand(gf, part);
+                    }
+                }
+            }
+            ggml_build_forward_expand(gf, ggml_sub(compute_ctx, x, v_pred));  // one step from t = 1000: x - v
+            return gf;
+        }
+
+        sd::Tensor<float> compute(int n_threads, const sd::Tensor<float>& noise, const sd::Tensor<float>& stream, int64_t t_offset) {
+            auto get_graph = [&]() -> ggml_cgraph* { return build_graph(noise, stream, t_offset); };
+            return restore_trailing_singleton_dims(GGMLRunner::compute(get_graph, n_threads, false), noise.dim());
+        }
+    };
+
+    struct DecoderRunner : public GGMLRunner {
+        TCDecoder dec;
+
+        DecoderRunner(ggml_backend_t backend,
+                      const String2TensorStorage& tensor_storage_map      = {},
+                      std::shared_ptr<RunnerWeightManager> weight_manager = nullptr)
+            : GGMLRunner(backend, weight_manager) {
+            dec.init(params_ctx, tensor_storage_map, "dec.decoder");
+        }
+
+        std::string get_desc() override { return "flashvsr-decoder"; }
+
+        void get_param_tensors(std::map<std::string, ggml_tensor*>& tensors) {
+            dec.get_param_tensors(tensors, "dec.decoder");
+        }
+
+        ggml_cgraph* build_graph(const sd::Tensor<float>& z_tensor, bool first) {
+            ggml_cgraph* gf = new_graph_custom(20480);
+            ggml_tensor* z  = make_input(z_tensor);
+            std::vector<ggml_tensor*> mem_in, mem_out;
+            if (!first) {
+                for (int m = 0; m < TCDecoder::num_mem; m++) {
+                    mem_in.push_back(get_cache_tensor_by_name("fvsr.mem." + std::to_string(m)));
+                }
+            }
+            auto runner_ctx = get_context();
+            auto out        = dec.forward(&runner_ctx, z, first, mem_in, mem_out);
+            for (int m = 0; m < TCDecoder::num_mem; m++) {
+                cache("fvsr.mem." + std::to_string(m), mem_out[m]);
+                ggml_build_forward_expand(gf, mem_out[m]);
+            }
+            ggml_build_forward_expand(gf, ggml_cont(compute_ctx, out));
+            return gf;
+        }
+
+        sd::Tensor<float> compute(int n_threads, const sd::Tensor<float>& z, bool first) {
+            auto get_graph = [&]() -> ggml_cgraph* { return build_graph(z, first); };
+            return restore_trailing_singleton_dims(GGMLRunner::compute(get_graph, n_threads, false), 4);
+        }
+    };
+
+}  // namespace FlashVSR
