--- /dev/null
+++ b/src/flashvsr.cpp
@@ -0,0 +1,441 @@
+// nightmare (dit/058): FlashVSR v1.1 tiny, 2x video upscaling (model: src/model/upscaler/flashvsr.hpp). The host side
+// of lihaoyun6/ComfyUI-FlashVSR_Ultra_Fast `4820b3f` (nodes.py flashvsr(), pipelines/flashvsr_tiny.py) for one scale, 2:
+// spatial tiles of the INPUT (each its own clip, as the reference's tiled_dit), the frame count padded to 8n + 5, the
+// tile upscaled bicubic to the LQ video, DiT chunks of 6 then 2 latent frames, TCDecoder, AdaIN colour fix per frame,
+// tiles feathered together. Env: FLASHVSR_DUMP=<dir> writes each stage as raw f32 (torch layouts), FLASHVSR_NOISE=<file>
+// reads the noise ([16, L, h, w] f32), FLASHVSR_DEC_CHUNK = latent frames a decoder call (default 2),
+// FLASHVSR_CONV_DIRECT=0 turns the decoder's direct convs off.
+#include <array>
+
+#include "core/ggml_extend_backend.h"
+#include "core/rng_mt19937.hpp"
+#include "core/util.h"
+#include "model/upscaler/flashvsr.hpp"
+#include "model_loader.h"
+#include "model_manager.h"
+#include "stable-diffusion.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+
+    constexpr int SCALE = 2;
+
+    void dump(const char* name, const float* data, size_t n) {
+        const char* dir = getenv("FLASHVSR_DUMP");
+        if (dir == nullptr) {
+            return;
+        }
+        std::string path = std::string(dir) + "/" + name + ".bin";
+        if (FILE* f = fopen(path.c_str(), "wb")) {
+            fwrite(data, sizeof(float), n, f);
+            fclose(f);
+        }
+    }
+
+    // torch F.interpolate(mode='bicubic', align_corners=False): A = -0.75, edge indices clamped, no antialias.
+    float cubic(float x) {
+        const float A = -0.75f;
+        x             = std::fabs(x);
+        if (x <= 1.f) {
+            return ((A + 2.f) * x - (A + 3.f)) * x * x + 1.f;
+        }
+        if (x < 2.f) {
+            return ((A * x - 5.f * A) * x + 8.f * A) * x - 4.f * A;
+        }
+        return 0.f;
+    }
+
+    // One RGB u8 region (x0, y0, w, h) of a frame, bicubic to (w*2, h*2), in [-1, 1], planar [3][H][W] into out.
+    void bicubic_tile(const sd_image_t& im, int x0, int y0, int w, int h, float* out) {
+        const int W = w * SCALE, H = h * SCALE;
+        std::vector<int> ix(W * 4), iy(H * 4);
+        std::vector<float> wx(W * 4), wy(H * 4);
+        auto taps = [](int n_out, int n_in, std::vector<int>& idx, std::vector<float>& wt) {
+            for (int o = 0; o < n_out; o++) {
+                float s  = (o + 0.5f) / SCALE - 0.5f;
+                int f    = (int)std::floor(s);
+                float t  = s - f;
+                for (int k = 0; k < 4; k++) {
+                    idx[o * 4 + k] = std::min(std::max(f - 1 + k, 0), n_in - 1);
+                    wt[o * 4 + k]  = cubic(t - (k - 1));
+                }
+            }
+        };
+        taps(W, w, ix, wx);
+        taps(H, h, iy, wy);
+        std::vector<float> rows((size_t)h * W * 3);
+        for (int y = 0; y < h; y++) {
+            const uint8_t* src = im.data + ((size_t)(y0 + y) * im.width + x0) * im.channel;
+            for (int o = 0; o < W; o++) {
+                for (int c = 0; c < 3; c++) {
+                    float v = 0.f;
+                    for (int k = 0; k < 4; k++) {
+                        v += wx[o * 4 + k] * (src[ix[o * 4 + k] * im.channel + c] / 255.f);
+                    }
+                    rows[((size_t)y * W + o) * 3 + c] = v;
+                }
+            }
+        }
+        for (int o = 0; o < H; o++) {
+            for (int x = 0; x < W; x++) {
+                for (int c = 0; c < 3; c++) {
+                    float v = 0.f;
+                    for (int k = 0; k < 4; k++) {
+                        v += wy[o * 4 + k] * rows[((size_t)iy[o * 4 + k] * W + x) * 3 + c];
+                    }
+                    out[((size_t)c * H + o) * W + x] = v * 2.f - 1.f;
+                }
+            }
+        }
+    }
+
+    std::vector<int> tile_starts(int size, int tile, int overlap) {
+        // nodes.py calculate_tile_coords along one axis: stride tile - overlap, the last tile pulled back to fit.
+        std::vector<int> starts;
+        if (size <= tile) {
+            return {0};
+        }
+        const int stride = tile - overlap;
+        const int n      = (int)std::ceil((size - overlap) / (double)stride);
+        for (int i = 0; i < n; i++) {
+            int s = i * stride;
+            if (s + tile > size) {
+                s = size - tile;
+            }
+            if (starts.empty() || starts.back() != s) {
+                starts.push_back(s);
+            }
+        }
+        return starts;
+    }
+
+}  // namespace
+
+struct FlashVSRGGML {
+    SDBackendManager backend_manager;
+    std::shared_ptr<ModelManager> model_manager;
+    std::shared_ptr<FlashVSR::DiTRunner> dit;
+    std::shared_ptr<FlashVSR::DecoderRunner> dec;
+    int n_threads = 4;
+    std::string backend_spec, params_backend_spec;
+    std::atomic<bool> cancelled{false};  // flashvsr_cancel: checked between graphs
+
+    ~FlashVSRGGML() {
+        model_manager.reset();
+        dit.reset();
+        dec.reset();
+    }
+
+    bool load(const std::string& path) {
+        ggml_log_set(sd_ggml_log_callback, nullptr);
+        std::string error;
+        if (!backend_manager.init(backend_spec.c_str(), params_backend_spec.c_str(), nullptr, &error)) {
+            LOG_ERROR("flashvsr backend config failed: %s", error.c_str());
+            return false;
+        }
+        ggml_backend_t backend        = backend_manager.runtime_backend(SDBackendModule::UPSCALER);
+        ggml_backend_t params_backend = backend_manager.params_backend(SDBackendModule::UPSCALER);
+        if (backend == nullptr || params_backend == nullptr) {
+            LOG_ERROR("flashvsr: no backend");
+            return false;
+        }
+        model_manager = std::make_shared<ModelManager>();
+        model_manager->set_n_threads(n_threads);
+        model_manager->set_enable_mmap(false);
+        ModelLoader loader;
+        if (!loader.init_from_file(path)) {
+            LOG_ERROR("flashvsr: cannot read '%s'", path.c_str());
+            return false;
+        }
+        auto& storage = loader.get_tensor_storage_map();
+        dit           = std::make_shared<FlashVSR::DiTRunner>(backend, storage, model_manager);
+        dec           = std::make_shared<FlashVSR::DecoderRunner>(backend, storage, model_manager);
+        dit->set_flash_attention_enabled(true);
+        // Required on HTP, not just faster: its backend repacks F16 3x3 conv weights for the HMX direct kernel, and
+        // im2col over a repacked weight is wrong (PipelineDit's vae_conv_direct). FLASHVSR_CONV_DIRECT=0 for an A/B.
+        const char* cd = getenv("FLASHVSR_CONV_DIRECT");
+        dec->set_conv2d_direct_enabled(cd == nullptr || atoi(cd) != 0);
+        const auto residency = backend_manager.params_backend_is_disk(SDBackendModule::UPSCALER) ? ModelManager::ResidencyMode::Disk
+                                                                                                 : ModelManager::ResidencyMode::ParamBackend;
+        if (!model_manager->set_loader(loader) ||
+            !model_manager->register_runner_params(ModelComponent::Diffusion, *dit, residency, backend, params_backend) ||
+            !model_manager->register_runner_params(ModelComponent::VAE, *dec, residency, backend, params_backend) ||
+            !model_manager->validate_registered_tensors()) {
+            LOG_ERROR("flashvsr: registering tensors failed");
+            return false;
+        }
+        return true;
+    }
+
+    // One tile of every frame: lq [3][F][H][W] in [-1, 1] (F = 8k + 9); returns [F'][3][H][W] in [-1, 1], colour fixed,
+    // F' = F - 4 (the reference's output count before its crop to the input's frames).
+    bool run_tile(const std::vector<float>& lq, int F, int H, int W, int64_t seed, int tile_index, int tiles,
+                  std::vector<float>& out, int& step, int steps, int64_t t_start) {
+        const int L = (F - 1) / 4, ptn = L / 2 - 2, h8 = H / 8, w8 = W / 8, h16 = H / 16, w16 = W / 16;
+        const size_t plane = (size_t)H * W;
+        auto px            = [&](int c, int f, int y, int x) { return lq[((size_t)c * F + f) * plane + (size_t)y * W + x]; };
+        dump("lq", lq.data(), lq.size());
+
+        // noise [16][L][h8][w8], one draw a tile from the same seed (the reference re-seeds every tile)
+        std::vector<float> noise((size_t)16 * L * h8 * w8);
+        if (const char* nf = getenv("FLASHVSR_NOISE")) {
+            FILE* f = fopen(nf, "rb");
+            if (f == nullptr || fread(noise.data(), sizeof(float), noise.size(), f) != noise.size()) {
+                LOG_ERROR("flashvsr: cannot read %zu floats from FLASHVSR_NOISE '%s'", noise.size(), nf);
+                if (f) fclose(f);
+                return false;
+            }
+            fclose(f);
+        } else {
+            MT19937RNG rng((uint64_t)seed);
+            noise = rng.randn((uint32_t)noise.size());
+        }
+
+        dit->free_cache_ctx_and_buffer();
+        std::vector<float> latents(noise.size());
+        for (int c = 0; c < ptn; c++) {
+            if (cancelled) {
+                return false;
+            }
+            const int a = c == 0 ? 0 : 4 + 2 * c, n = c == 0 ? 6 : 2;
+            sd::Tensor<float> x({w8, h8, n, 16});
+            for (int ch = 0; ch < 16; ch++) {
+                memcpy(x.data() + (size_t)ch * n * h8 * w8, noise.data() + ((size_t)ch * L + a) * h8 * w8, sizeof(float) * n * h8 * w8);
+            }
+            // the LQ stream S[i] = frame max(0, i - 5), PixelShuffle3d(1, 16, 16): [768][len][h16][w16]
+            const int len = 4 * n + FlashVSR::LQ_LEAD;
+            sd::Tensor<float> s({w16, h16, len, FlashVSR::LQ_CHANNELS});
+            float* sp = s.data();
+            for (int c3 = 0; c3 < 3; c3++)
+                for (int hi = 0; hi < 16; hi++)
+                    for (int wi = 0; wi < 16; wi++) {
+                        const int ch = (c3 * 16 + hi) * 16 + wi;
+                        for (int t = 0; t < len; t++) {
+                            const int f = std::max(0, 4 * a + t - 5);
+                            for (int y = 0; y < h16; y++)
+                                for (int xx = 0; xx < w16; xx++) {
+                                    sp[(((size_t)ch * len + t) * h16 + y) * w16 + xx] = px(c3, f, y * 16 + hi, xx * 16 + wi);
+                                }
+                        }
+                    }
+            auto r = dit->compute(n_threads, x, s, a);
+            if (r.empty()) {
+                LOG_ERROR("flashvsr: DiT chunk %d failed", c);
+                return false;
+            }
+            for (int ch = 0; ch < 16; ch++) {
+                memcpy(latents.data() + ((size_t)ch * L + a) * h8 * w8, r.data() + (size_t)ch * n * h8 * w8, sizeof(float) * n * h8 * w8);
+            }
+            pretty_progress(++step, steps, (ggml_time_ms() - t_start) / 1000.f);
+        }
+        dit->free_cache_ctx_and_buffer();
+        dit->runner_end();
+        dump("latents", latents.data(), latents.size());
+
+        // decoder: [W8, H8, 784, n] per chunk, channels = PixelShuffle3d(4, 8, 8) of LQ frames 4j-3..4j (frame 0 before
+        // the start), then the latent
+        const char* dc   = getenv("FLASHVSR_DEC_CHUNK");
+        const int dchunk = std::max(1, dc ? atoi(dc) : 2);
+        const int Fo     = 4 * L - 3;
+        out.assign((size_t)Fo * 3 * plane, 0.f);
+        dec->free_cache_ctx_and_buffer();
+        int written = 0;
+        for (int a = 0; a < L; a += dchunk) {
+            if (cancelled) {
+                return false;
+            }
+            const int n = std::min(dchunk, L - a);
+            sd::Tensor<float> z({w8, h8, FlashVSR::DEC_CHANNELS + 16, n});
+            float* zp = z.data();
+            for (int j = 0; j < n; j++) {
+                const int lj = a + j;
+                float* zj    = zp + (size_t)j * (FlashVSR::DEC_CHANNELS + 16) * h8 * w8;
+                for (int c3 = 0; c3 < 3; c3++)
+                    for (int fi = 0; fi < 4; fi++) {
+                        const int f = std::max(0, 4 * lj - 3 + fi);
+                        for (int hi = 0; hi < 8; hi++)
+                            for (int wi = 0; wi < 8; wi++) {
+                                const int ch = ((c3 * 4 + fi) * 8 + hi) * 8 + wi;
+                                for (int y = 0; y < h8; y++)
+                                    for (int xx = 0; xx < w8; xx++) {
+                                        zj[((size_t)ch * h8 + y) * w8 + xx] = px(c3, f, y * 8 + hi, xx * 8 + wi);
+                                    }
+                            }
+                    }
+                for (int ch = 0; ch < 16; ch++) {
+                    memcpy(zj + (size_t)(FlashVSR::DEC_CHANNELS + ch) * h8 * w8, latents.data() + ((size_t)ch * L + lj) * h8 * w8, sizeof(float) * h8 * w8);
+                }
+            }
+            auto r = dec->compute(n_threads, z, a == 0);
+            if (r.empty()) {
+                LOG_ERROR("flashvsr: decoder chunk at %d failed", a);
+                return false;
+            }
+            const int frames = (int)r.shape()[3];
+            for (int k = 0; k < frames && written < Fo; k++, written++) {
+                float* o       = out.data() + (size_t)written * 3 * plane;
+                const float* d = r.data() + (size_t)k * 3 * plane;
+                for (size_t i = 0; i < 3 * plane; i++) {
+                    o[i] = d[i] * 2.f - 1.f;
+                }
+            }
+            pretty_progress(++step, steps, (ggml_time_ms() - t_start) / 1000.f);
+        }
+        dec->free_cache_ctx_and_buffer();
+        dec->runner_end();
+        dump("dec_out", out.data(), out.size());
+
+        // AdaIN to the LQ frame, per frame and channel (flashvsr_tiny.py ColorCorrector, method 'adain'), clamp [-1, 1]
+        for (int f = 0; f < Fo; f++) {
+            for (int c = 0; c < 3; c++) {
+                float* o        = out.data() + ((size_t)f * 3 + c) * plane;
+                const float* l  = lq.data() + ((size_t)c * F + f) * plane;
+                double so = 0, so2 = 0, sl = 0, sl2 = 0;
+                for (size_t i = 0; i < plane; i++) {
+                    so += o[i], so2 += (double)o[i] * o[i], sl += l[i], sl2 += (double)l[i] * l[i];
+                }
+                const double mo = so / plane, ml = sl / plane;
+                const double vo = std::max(0.0, so2 / plane - mo * mo) + 1e-5, vl = std::max(0.0, sl2 / plane - ml * ml) + 1e-5;
+                const float k = (float)std::sqrt(vl / vo), b = (float)(ml - mo * std::sqrt(vl / vo));
+                for (size_t i = 0; i < plane; i++) {
+                    o[i] = std::min(1.f, std::max(-1.f, o[i] * k + b));
+                }
+            }
+        }
+        dump("final", out.data(), out.size());
+        LOG_INFO("flashvsr: tile %d/%d done", tile_index + 1, tiles);
+        return true;
+    }
+
+    // frames: N RGB frames, all the same size; out: N frames at 2x. tile/overlap in INPUT pixels (the reference: 256, 24).
+    bool upscale(const sd_image_t* frames, int N, int tile, int overlap, int64_t seed, sd_image_t* out) {
+        if (N <= 0 || frames[0].channel < 3) {
+            return false;
+        }
+        const int iw = (int)frames[0].width, ih = (int)frames[0].height, ow = iw * SCALE, oh = ih * SCALE;
+        // nodes.py: pad the clip with its last frame to 8n + 5 (at least 21), then 4 more to 8k + 9 for the pipeline
+        const int Np = N < 21 ? 21 : ((N - 5 + 7) / 8) * 8 + 5, F = Np + 4;
+        const auto xs = tile_starts(iw, tile, overlap), ys = tile_starts(ih, tile, overlap);
+        const int tiles = (int)(xs.size() * ys.size());
+        const int L = (F - 1) / 4, dc = std::max(1, getenv("FLASHVSR_DEC_CHUNK") ? atoi(getenv("FLASHVSR_DEC_CHUNK")) : 2);
+        const int steps = tiles * (L / 2 - 2 + (L + dc - 1) / dc);
+        int step        = 0;
+        const int64_t t0 = ggml_time_ms();
+        for (int i = 0; i < N; i++) {
+            out[i] = {(uint32_t)ow, (uint32_t)oh, 3, (uint8_t*)calloc((size_t)ow * oh * 3, 1)};
+            if (out[i].data == nullptr) {
+                return false;
+            }
+        }
+        std::vector<float> acc((size_t)ow * oh, 0.f), lq, res;
+        int ti = 0;
+        for (int ty : ys) {
+            for (int tx : xs) {
+                const int tw = std::min(tile, iw), th = std::min(tile, ih);
+                // the tile's LQ size, padded up to a multiple of 16 (edge replicated) where the frame is smaller than a tile
+                const int W = (tw * SCALE + 15) / 16 * 16, H = (th * SCALE + 15) / 16 * 16, w2 = tw * SCALE, h2 = th * SCALE;
+                const size_t plane = (size_t)H * W;
+                lq.assign((size_t)3 * F * plane, 0.f);
+                std::vector<float> one((size_t)3 * w2 * h2);
+                for (int f = 0; f < F; f++) {
+                    bicubic_tile(frames[std::min(f, N - 1)], tx, ty, tw, th, one.data());  // padding repeats the last frame
+                    for (int c = 0; c < 3; c++)
+                        for (int y = 0; y < H; y++)
+                            for (int x = 0; x < W; x++) {
+                                lq[((size_t)c * F + f) * plane + (size_t)y * W + x] = one[((size_t)c * h2 + std::min(y, h2 - 1)) * w2 + std::min(x, w2 - 1)];
+                            }
+                }
+                if (!run_tile(lq, F, H, W, seed, ti, tiles, res, step, steps, t0)) {
+                    dit->free_cache_ctx_and_buffer();
+                    dec->free_cache_ctx_and_buffer();
+                    LOG_INFO("flashvsr: %s at tile %d/%d", cancelled ? "cancelled" : "failed", ti + 1, tiles);
+                    return false;
+                }
+                // feather the tile in: a linear ramp over the overlap on each side that has a neighbour
+                const int ox = tx * SCALE, oy = ty * SCALE, R = overlap * SCALE;
+                for (int y = 0; y < h2; y++) {
+                    for (int x = 0; x < w2; x++) {
+                        float wgt = 1.f;
+                        if (tx > 0 && x < R) wgt = std::min(wgt, (x + 1.f) / (R + 1.f));
+                        if (tx + tw < iw && x >= w2 - R) wgt = std::min(wgt, (w2 - x) / (R + 1.f));
+                        if (ty > 0 && y < R) wgt = std::min(wgt, (y + 1.f) / (R + 1.f));
+                        if (ty + th < ih && y >= h2 - R) wgt = std::min(wgt, (h2 - y) / (R + 1.f));
+                        const size_t p = (size_t)(oy + y) * ow + ox + x;
+                        const float a0 = acc[p], a1 = a0 + wgt;
+                        for (int f = 0; f < N; f++) {
+                            uint8_t* d = out[f].data + p * 3;
+                            for (int c = 0; c < 3; c++) {
+                                const float v = (res[((size_t)f * 3 + c) * plane + (size_t)y * W + x] + 1.f) * 127.5f;
+                                d[c]          = (uint8_t)std::lround(std::min(255.f, std::max(0.f, (d[c] * a0 + v * wgt) / a1)));
+                            }
+                        }
+                        acc[p] = a1;
+                    }
+                }
+                ti++;
+            }
+        }
+        LOG_INFO("flashvsr: %d frames %dx%d -> %dx%d, %d tiles, %.1f s", N, iw, ih, ow, oh, tiles, (ggml_time_ms() - t0) / 1000.f);
+        return true;
+    }
+};
+
+struct flashvsr_ctx_t {
+    FlashVSRGGML* vsr = nullptr;
+};
+
+flashvsr_ctx_t* new_flashvsr_ctx(const char* model_path, int n_threads, const char* backend, const char* params_backend) {
+    auto* vsr                = new FlashVSRGGML();
+    vsr->n_threads           = n_threads;
+    vsr->backend_spec        = SAFE_STR(backend);
+    vsr->params_backend_spec = SAFE_STR(params_backend);
+    if (!vsr->load(SAFE_STR(model_path))) {
+        delete vsr;
+        return nullptr;
+    }
+    auto* ctx = (flashvsr_ctx_t*)malloc(sizeof(flashvsr_ctx_t));
+    ctx->vsr  = vsr;
+    return ctx;
+}
+
+void free_flashvsr_ctx(flashvsr_ctx_t* ctx) {
+    if (ctx == nullptr) {
+        return;
+    }
+    delete ctx->vsr;
+    free(ctx);
+}
+
+bool flashvsr_upscale(flashvsr_ctx_t* ctx, const sd_image_t* frames, int num_frames, int tile_size, int tile_overlap,
+                      int64_t seed, sd_image_t** frames_out) {
+    if (frames_out == nullptr) {
+        return false;
+    }
+    *frames_out = nullptr;
+    if (ctx == nullptr || ctx->vsr == nullptr || frames == nullptr || num_frames <= 0) {
+        return false;
+    }
+    ctx->vsr->cancelled = false;
+    auto* out = (sd_image_t*)calloc(num_frames, sizeof(sd_image_t));
+    if (out == nullptr) {
+        return false;
+    }
+    if (!ctx->vsr->upscale(frames, num_frames, tile_size > 0 ? tile_size : 256, tile_overlap >= 0 ? tile_overlap : 24, seed, out)) {
+        free_sd_images(out, num_frames);
+        return false;
+    }
+    *frames_out = out;
+    return true;
+}
+
+void flashvsr_cancel(flashvsr_ctx_t* ctx) {
+    if (ctx != nullptr && ctx->vsr != nullptr) {
+        ctx->vsr->cancelled = true;
+    }
+}
