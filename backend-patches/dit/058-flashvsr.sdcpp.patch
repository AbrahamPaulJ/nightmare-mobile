+                             int64_t seed,
+                             sd_image_t** frames_out);
+// Stops a running flashvsr_upscale at its next graph (it then returns false); safe from the progress callback.
+SD_API void flashvsr_cancel(flashvsr_ctx_t* flashvsr_ctx);
+
 typedef struct adetailer_ctx_t adetailer_ctx_t;
 
 typedef struct {
diff --git a/src/flashvsr.cpp b/src/flashvsr.cpp
