index 0000000..6d5d012
--- /dev/null
+++ b/examples/flashvsr/main.cpp
@@ -0,0 +1,109 @@
+// nightmare (dit/058): flashvsr-cli MODEL.gguf IN_DIR OUT_DIR [-v] [-t threads] [--tile N] [--overlap N] [--seed N]
+//   [--frames N] [--crop x,y,w,h] [--backend SPEC] [--params-backend SPEC]
+// Upscales the PNG frames of IN_DIR (sorted by name) 2x with FlashVSR into OUT_DIR/out_000.png ... Env as in
+// src/flashvsr.cpp (FLASHVSR_DUMP, FLASHVSR_NOISE, FLASHVSR_DEC_CHUNK).
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+#include "stable-diffusion.h"
+
+#define STB_IMAGE_IMPLEMENTATION
+#define STB_IMAGE_STATIC
+#include "stb_image.h"
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#define STB_IMAGE_WRITE_STATIC
+#include "stb_image_write.h"
+
+namespace fs = std::filesystem;
+
+static bool g_verbose = false;
+
+static void on_log(enum sd_log_level_t level, const char* text, void*) {
+    if (g_verbose || level >= SD_LOG_INFO) {
+        fputs(text, stderr);
+    }
+}
+
+static void on_progress(int step, int steps, float time, void*) {
+    fprintf(stderr, "progress %d/%d %.1f s\n", step, steps, time);
+}
+
+int main(int argc, char** argv) {
+    if (argc < 4) {
+        fprintf(stderr, "usage: %s MODEL.gguf IN_DIR OUT_DIR [-t N] [--tile N] [--overlap N] [--seed N] [--frames N] [--crop x,y,w,h]\n", argv[0]);
+        return 1;
+    }
+    int threads = 4, tile = 256, overlap = 24, max_frames = 0, cx = 0, cy = 0, cw = 0, ch = 0;
+    int64_t seed       = 42;
+    const char* backend = nullptr;
+    const char* pbackend = nullptr;
+    for (int i = 4; i < argc; i++) {
+        if (std::string(argv[i]) == "-v") g_verbose = true;  // every log level (GGML_HEXAGON_PROFILE's lines are DEBUG)
+    }
+    for (int i = 4; i + 1 < argc; i += 2) {
+        std::string a = argv[i];
+        if (a == "-v") {
+            i--;
+            continue;
+        }
+        if (a == "-t") threads = atoi(argv[i + 1]);
+        else if (a == "--tile") tile = atoi(argv[i + 1]);
+        else if (a == "--overlap") overlap = atoi(argv[i + 1]);
+        else if (a == "--seed") seed = atoll(argv[i + 1]);
+        else if (a == "--frames") max_frames = atoi(argv[i + 1]);
+        else if (a == "--crop") sscanf(argv[i + 1], "%d,%d,%d,%d", &cx, &cy, &cw, &ch);
+        else if (a == "--backend") backend = argv[i + 1];
+        else if (a == "--params-backend") pbackend = argv[i + 1];
+    }
+    sd_set_log_callback(on_log, nullptr);
+    sd_set_progress_callback(on_progress, nullptr);
+
+    std::vector<std::string> names;
+    for (auto& e : fs::directory_iterator(argv[2])) {
+        if (e.path().extension() == ".png") names.push_back(e.path().string());
+    }
+    std::sort(names.begin(), names.end());
+    if (max_frames > 0 && (int)names.size() > max_frames) names.resize(max_frames);
+    std::vector<sd_image_t> frames;
+    for (auto& n : names) {
+        int w, h, c;
+        uint8_t* d = stbi_load(n.c_str(), &w, &h, &c, 3);
+        if (d == nullptr) {
+            fprintf(stderr, "cannot read %s\n", n.c_str());
+            return 1;
+        }
+        if (cw > 0 && ch > 0) {
+            uint8_t* t = (uint8_t*)malloc((size_t)cw * ch * 3);
+            for (int y = 0; y < ch; y++) memcpy(t + (size_t)y * cw * 3, d + ((size_t)(cy + y) * w + cx) * 3, (size_t)cw * 3);
+            stbi_image_free(d);
+            d = t, w = cw, h = ch;
+        }
+        frames.push_back({(uint32_t)w, (uint32_t)h, 3, d});
+    }
+    fprintf(stderr, "%zu frames %ux%u\n", frames.size(), frames.empty() ? 0 : frames[0].width, frames.empty() ? 0 : frames[0].height);
+    flashvsr_ctx_t* ctx = new_flashvsr_ctx(argv[1], threads, backend, pbackend);
+    if (ctx == nullptr) {
+        fprintf(stderr, "load failed\n");
+        return 2;
+    }
+    sd_image_t* out = nullptr;
+    if (!flashvsr_upscale(ctx, frames.data(), (int)frames.size(), tile, overlap, seed, &out)) {
+        fprintf(stderr, "upscale failed\n");
+        return 3;
+    }
+    fs::create_directories(argv[3]);
+    for (size_t i = 0; i < frames.size(); i++) {
+        char p[4096];
+        snprintf(p, sizeof(p), "%s/out_%03zu.png", argv[3], i);
+        stbi_write_png(p, out[i].width, out[i].height, 3, out[i].data, out[i].width * 3);
+    }
+    free_sd_images(out, (int)frames.size());
+    free_flashvsr_ctx(ctx);
+    fprintf(stderr, "wrote %zu frames\n", frames.size());
+    return 0;
+}
