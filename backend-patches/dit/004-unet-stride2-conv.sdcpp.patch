+ggml_tensor* ggml_ext_keep_even_2d(ggml_context* ctx, ggml_tensor* x) {
+    const int64_t W = x->ne[0];
+    const int64_t H = x->ne[1];
+    const int64_t C = x->ne[2];
+    const int64_t N = x->ne[3];
+    GGML_ASSERT(W % 2 == 0 && H % 2 == 0);
+    const size_t es = ggml_element_size(x);
+    // [N*C*H/2, 2, W/2, 2] -> pick index 0 on both size-2 axes.
+    if (!ggml_is_contiguous(x)) {
+        x = ggml_cont(ctx, x);
+    }
+    x = ggml_reshape_4d(ctx, x, 2, W / 2, 2, (H / 2) * C * N);
+    x = ggml_view_4d(ctx, x, 1, W / 2, 1, (H / 2) * C * N, 2 * es, W * es, 2 * W * es, 0);
+    return ggml_reshape_4d(ctx, ggml_cont(ctx, x), W / 2, H / 2, C, N);
+}
