+        // stride 1 only; a stride-2 conv would fall back and read them
+        // scrambled. out[i][j] of a 3x3 s2 p1 conv is full[2i][2j] of the
+        // s1 p1 one. This is the path every conv takes under a runtime LoRA.
+        if (s0 == 2 && s1 == 2 && p0 == 1 && p1 == 1 && d0 == 1 && d1 == 1 &&
+            w->ne[0] == 3 && w->ne[1] == 3 && x->ne[0] % 2 == 0 && x->ne[1] % 2 == 0) {
+            x = ggml_ext_keep_even_2d(ctx, ggml_conv_2d_direct(ctx, w, x, 1, 1, 1, 1, 1, 1));
+        } else {
+            x = ggml_conv_2d_direct(ctx, w, x, s0, s1, p0, p1, d0, d1);
+        }
     } else {
