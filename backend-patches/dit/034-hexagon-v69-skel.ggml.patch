diff --git a/src/ggml-hexagon/htp/hvx-base.h b/src/ggml-hexagon/htp/hvx-base.h
index d7575b9..6aae531 100644
--- a/src/ggml-hexagon/htp/hvx-base.h
+++ b/src/ggml-hexagon/htp/hvx-base.h
@@ -9,6 +9,58 @@
 #include "hex-utils.h"
 #include "hvx-types.h"
 
+#if __HVX_ARCH__ < 73
+// nightmare dit/034: v69 (8 Gen 1 / 8+ Gen 1) lacks v73's vconv. The three this code uses, from base HVX and v68's
+// qfloat, under the same names so no caller changes. v73 and up never see these.
+
+// int32 -> fp32. |x| < 2^22 is exact (1.5 * 2^23 + x read as a float, minus 1.5 * 2^23); larger values go as
+// hi * 65536 + lo, rounded once.
+static inline HVX_Vector Q6_Vsf_equals_Vw(HVX_Vector x) {
+    const HVX_Vector magic = Q6_V_vsplat_R(0x4B400000);
+    const HVX_Vector lim   = Q6_V_vsplat_R(0x00400000);
+    const HVX_Vector nlim  = Q6_V_vsplat_R(0xFFC00000);
+    HVX_Vector small = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_VsfVsf(Q6_Vw_vadd_VwVw(x, magic), magic));
+    HVX_Vector hi    = Q6_Vw_vasr_VwR(x, 16);
+    HVX_Vector lo    = Q6_V_vand_VV(x, Q6_V_vsplat_R(0xFFFF));
+    HVX_Vector hi_f  = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_VsfVsf(Q6_Vw_vadd_VwVw(hi, magic), magic));
+    HVX_Vector lo_f  = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_VsfVsf(Q6_Vw_vadd_VwVw(lo, magic), magic));
+    HVX_Vector big   = Q6_Vqf32_vmpy_VsfVsf(hi_f, Q6_V_vsplat_R(0x47800000));  // * 65536.0f
+    big              = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(big, lo_f));
+    HVX_VectorPred in = Q6_Q_and_QQ(Q6_Q_vcmp_gt_VwVw(lim, x), Q6_Q_vcmp_gt_VwVw(x, nlim));
+    return Q6_V_vmux_QVV(in, small, big);
+}
+
+// fp16 -> int16, toward zero, saturating: the 11-bit significand shifted by its exponent.
+static inline HVX_Vector Q6_Vh_equals_Vhf(HVX_Vector v) {
+    const HVX_Vector zero = Q6_V_vzero();
+    const HVX_Vector k15  = Q6_Vh_vsplat_R(15);
+    HVX_Vector e  = Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(v, 10), Q6_Vh_vsplat_R(0x1F));
+    HVX_Vector m  = Q6_V_vor_VV(Q6_V_vand_VV(v, Q6_Vh_vsplat_R(0x3FF)), Q6_Vh_vsplat_R(0x400));
+    HVX_Vector rs = Q6_Vh_vmin_VhVh(Q6_Vh_vmax_VhVh(Q6_Vh_vsub_VhVh(Q6_Vh_vsplat_R(25), e), zero), k15);
+    HVX_Vector ls = Q6_Vh_vmin_VhVh(Q6_Vh_vmax_VhVh(Q6_Vh_vsub_VhVh(e, Q6_Vh_vsplat_R(25)), zero), k15);
+    HVX_Vector r  = Q6_Vh_vasl_VhVh(Q6_Vh_vasr_VhVh(m, rs), ls);
+    r = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhVh(e, Q6_Vh_vsplat_R(29)), Q6_Vh_vsplat_R(0x7FFF), r);
+    return Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhVh(zero, v), Q6_Vh_vsub_VhVh(zero, r), r);
+}
+
+// int16 -> fp16, nearest (ties away): the exponent from the leading one; a significand that rounds up to 2048
+// carries into the exponent by itself.
+static inline HVX_Vector Q6_Vhf_equals_Vh(HVX_Vector x) {
+    const HVX_Vector zero = Q6_V_vzero();
+    const HVX_Vector one  = Q6_Vh_vsplat_R(1);
+    const HVX_Vector k10  = Q6_Vh_vsplat_R(10);
+    HVX_Vector a    = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhVh(zero, x), Q6_Vh_vsub_VhVh(zero, x), x);  // |x|, 0x8000 for -32768
+    HVX_Vector p    = Q6_Vh_vsub_VhVh(Q6_Vh_vsplat_R(15), Q6_Vuh_vcl0_Vuh(a));             // the leading one's bit
+    HVX_Vector rs   = Q6_Vh_vmax_VhVh(Q6_Vh_vsub_VhVh(p, k10), zero);
+    HVX_Vector ls   = Q6_Vh_vmax_VhVh(Q6_Vh_vsub_VhVh(k10, p), zero);
+    HVX_Vector half = Q6_Vh_vlsr_VhVh(Q6_Vh_vasl_VhVh(one, rs), one);                         // 1 << (rs - 1), 0 at rs 0
+    HVX_Vector m    = Q6_Vh_vasl_VhVh(Q6_Vh_vlsr_VhVh(Q6_Vh_vadd_VhVh(a, half), rs), ls);    // 1024..2048
+    HVX_Vector bits = Q6_Vh_vadd_VhVh(Q6_Vh_vasl_VhR(Q6_Vh_vadd_VhVh(p, Q6_Vh_vsplat_R(14)), 10), m);
+    bits = Q6_V_vor_VV(bits, Q6_V_vand_VV(x, Q6_Vh_vsplat_R(0x8000)));
+    return Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VhVh(x, zero), zero, bits);
+}
+#endif  // __HVX_ARCH__ < 73
+
 #define hvx_vmem(A)   *((HVX_Vector *)(A))
 #define hvx_vmemu(A)  *((HVX_UVector *)(A))
 
