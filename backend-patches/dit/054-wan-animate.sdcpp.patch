+    public:
+        AnimateFaceBlock(int64_t dim, int64_t num_heads)
+            : dim(dim), num_heads(num_heads) {
+            blocks["linear1_kv"]      = std::make_shared<Linear>(dim, dim * 2);
+            blocks["linear1_q"]       = std::make_shared<Linear>(dim, dim);
+            blocks["linear2"]         = std::make_shared<Linear>(dim, dim);
+            blocks["q_norm"]          = std::make_shared<RMSNorm>(dim / num_heads, 1e-6f);
+            blocks["k_norm"]          = std::make_shared<RMSNorm>(dim / num_heads, 1e-6f);
