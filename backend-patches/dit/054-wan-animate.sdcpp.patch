+
+        // x: [dim, S, 1] with S = T * frame_tokens; face: [dim, 5, T].
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* face, int64_t frame_tokens, int64_t chunk_tokens) {
+            ggml_context* c   = ctx->ggml_ctx;
+            const int64_t D   = dim / num_heads;
+            const int64_t T   = face->ne[2];
+            const int64_t nf  = face->ne[1];
+            GGML_ASSERT(frame_tokens > 0 && x->ne[1] == T * frame_tokens);
+            auto lin = [&](const char* n) { return std::dynamic_pointer_cast<Linear>(blocks[n]); };
+
+            auto kv = lin("linear1_kv")->forward(ctx, std::dynamic_pointer_cast<LayerNorm>(blocks["pre_norm_motion"])->forward(ctx, face));  // [2*dim, 5, T]
+            auto k  = ggml_cont(c, ggml_view_3d(c, kv, dim, nf, T, kv->nb[1], kv->nb[2], 0));
+            auto v  = ggml_cont(c, ggml_view_3d(c, kv, dim, nf, T, kv->nb[1], kv->nb[2], dim * ggml_element_size(kv)));
+            k       = std::dynamic_pointer_cast<RMSNorm>(blocks["k_norm"])->forward(ctx, ggml_reshape_4d(c, k, D, num_heads, nf, T));
+            k       = ggml_cont(c, ggml_permute(c, k, 0, 2, 1, 3));                                // [D, 5, H, T]
+            v       = ggml_cont(c, ggml_permute(c, ggml_reshape_4d(c, v, D, num_heads, nf, T), 1, 2, 0, 3));  // [5, D, H, T]
+
+            int64_t frames_per_chunk = chunk_tokens > 0 ? std::max<int64_t>(1, chunk_tokens / frame_tokens) : T;
+            ggml_tensor* out         = nullptr;
+            for (int64_t f0 = 0; f0 < T; f0 += frames_per_chunk) {
+                const int64_t tc = std::min(frames_per_chunk, T - f0);
+                auto xc          = wan_token_rows(c, x, f0 * frame_tokens, tc * frame_tokens);
+                auto q           = lin("linear1_q")->forward(ctx, std::dynamic_pointer_cast<LayerNorm>(blocks["pre_norm_feat"])->forward(ctx, xc));
+                q                = std::dynamic_pointer_cast<RMSNorm>(blocks["q_norm"])->forward(ctx, ggml_reshape_4d(c, q, D, num_heads, frame_tokens, tc));
+                q                = ggml_cont(c, ggml_permute(c, q, 0, 2, 1, 3));  // [D, ftok, H, tc]
+                auto kc          = ggml_view_4d(c, k, D, nf, num_heads, tc, k->nb[1], k->nb[2], k->nb[3], f0 * k->nb[3]);
+                auto vc          = ggml_view_4d(c, v, nf, D, num_heads, tc, v->nb[1], v->nb[2], v->nb[3], f0 * v->nb[3]);
+                auto s           = ggml_mul_mat(c, kc, q);                                            // [5, ftok, H, tc]
+                s                = ggml_soft_max_ext(c, s, nullptr, 1.f / std::sqrt((float)D), 0.f);
