+                o                = lin("linear2")->forward(ctx, ggml_reshape_3d(c, o, dim, tc * frame_tokens, 1));
+                out              = out == nullptr ? o : ggml_concat(c, out, o, 1);
+            }
+            return out;
+        }
+    };
