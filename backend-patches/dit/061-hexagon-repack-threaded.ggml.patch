+// nightmare (dit/061): a repack's column tiles are independent (each writes only its own tiles), so a
+// large weight is repacked on every core. Streamed DiTs re-upload their weights every step, one tensor
+// at a time under the loader's tensor_set mutex, and these loops ran on one thread.
+template <typename F> static void hex_repack_parallel(int n, size_t bytes, F && fn) {
+    const int n_threads = (int) std::min<size_t>(std::max(1u, std::thread::hardware_concurrency()),
+                                                 std::min<size_t>((size_t) n, std::max<size_t>(1, bytes >> 20)));
+    if (n_threads <= 1) {
+        for (int i = 0; i < n; ++i) {
+            fn(i);
+        }
+        return;
+    }
+    std::vector<std::thread> workers;
+    for (int w = 0; w < n_threads; ++w) {
+        workers.emplace_back([&, w]() {
+            for (int i = (int) ((int64_t) n * w / n_threads); i < (int) ((int64_t) n * (w + 1) / n_threads); ++i) {
+                fn(i);
+            }
+        });
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+}
