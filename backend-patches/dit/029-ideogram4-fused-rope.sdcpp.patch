+    // nightmare (dit/029): Q/K norm and rope as ONE fused op (the HTP's qknorm_rope), as flux.hpp, krea2.hpp,
+    // anima.hpp and wan.hpp already do. The composed Rope::apply_rope cost ~73 s a step at 768x768 on the S25
+    // (permutes, conts and two REPEATs per q and k in each of 34 blocks, a 511 MB CPU compute buffer). The fused
+    // kernel rotates interleaved pairs (2j, 2j+1) and Ideogram's rope is split-half (j, j+d/2): q, k and the norm
+    // weight get the same channel permutation into interleaved order, which leaves q.k, so the attention, unchanged.
+    // NM_IDEOGRAM_COMPOSED_ROPE=1 keeps the old path (the A/B control).
+    class Ideogram4QKNorm : public RMSNorm {
+    public:
+        using RMSNorm::RMSNorm;
+
+        ggml_tensor* forward_rope(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* pe) {
+            static const bool composed = getenv("NM_IDEOGRAM_COMPOSED_ROPE") != nullptr;
+            if (composed || ctx->backend == nullptr || x->ne[3] != 1 || x->type != GGML_TYPE_F32) {
+                return nullptr;
+            }
+            ggml_tensor* w = params["weight"];
+            if (ctx->weight_adapter) {
+                w = ctx->weight_adapter->patch_weight(ctx->ggml_ctx, ctx->backend, w, prefix + "weight");
+            }
+            const int64_t d    = x->ne[0];
+            const int64_t half = d / 2;
+            // x: [d, H, L, 1] -> [d/2, 2, H, L] -> [2, d/2, H, L]: new[2j] = x[j], new[2j+1] = x[j + d/2]
+            ggml_tensor* xi = ggml_view_4d(ctx->ggml_ctx, x, half, 2, x->ne[1], x->ne[2],
+                                           half * ggml_element_size(x), x->nb[1], x->nb[2], 0);
+            xi              = ggml_cont(ctx->ggml_ctx, ggml_permute(ctx->ggml_ctx, xi, 1, 0, 2, 3));
+            xi              = ggml_reshape_4d(ctx->ggml_ctx, xi, d, x->ne[1], x->ne[2], 1);
+            ggml_tensor* wi = ggml_reshape_2d(ctx->ggml_ctx, w, half, 2);
+            wi              = ggml_cont(ctx->ggml_ctx, ggml_transpose(ctx->ggml_ctx, wi));
+            wi              = ggml_reshape_1d(ctx->ggml_ctx, wi, d);
+            ggml_tensor* out = ggml_qknorm_rope(ctx->ggml_ctx, xi, wi, pe, eps);  // [d, L, H]
+            if (!ggml_backend_supports_op(ctx->backend, out)) {
+                return nullptr;
+            }
+            return out;
+        }
+    };
+
