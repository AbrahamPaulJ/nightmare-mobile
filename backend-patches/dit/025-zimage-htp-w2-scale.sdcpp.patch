+            if (sd_backend_is(ctx->backend, "HTP") && w2->weight_type() != GGML_TYPE_F8_E4M3) {
+                static const float htp_w2_scale = [] {
+                    const char* e = getenv("SD_ZIMAGE_W2_SCALE");
+                    return e ? (float)atof(e) : 1.f / 8192.f;
+                }();
+                w2->set_scale(htp_w2_scale);
+            }
 
