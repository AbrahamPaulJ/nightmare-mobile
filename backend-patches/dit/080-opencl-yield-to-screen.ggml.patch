dit/080: ggml-opencl yields the GPU to the screen between ops (env GGML_OPENCL_YIELD_EVERY / _US / _LOG).
The S25 lagged severely running Z-Image on OpenCL with 2.2 GB of RAM free: the UI and the DiT share the Adreno.
Text before the first diff line is ignored by git apply.

--- a/src/ggml-opencl/ggml-opencl.cpp
+++ b/src/ggml-opencl/ggml-opencl.cpp
@@ -49,6 +49,8 @@
 #include <regex>
 #include <set>
 #include <unordered_set>
+#include <chrono>
+#include <thread>
 
 #undef MIN
 #undef MAX
@@ -8206,6 +8208,19 @@
 static ggml_status ggml_backend_opencl_graph_compute(ggml_backend_t backend, ggml_cgraph * cgraph) {
     ggml_backend_opencl_context *backend_ctx = (ggml_backend_opencl_context *)backend->context;
 
+    // nightmare (dit/080): give the screen its turns on the GPU. A phone draws its UI on the same Adreno, and a DiT's
+    // graph was enqueued back to back: the S25 lagged severely at 512^2 with 2.2 GB of RAM still free (2026-10-31).
+    // GGML_OPENCL_YIELD_EVERY=N waits for the queue to drain after every N ops and sleeps GGML_OPENCL_YIELD_US (2000)
+    // so the compositor gets the GPU; GGML_OPENCL_YIELD_LOG=1 prints each graph's longest wait. With N = 1 that wait is
+    // one op's GPU time: an op longer than a frame cannot be helped by yielding between ops and must be split.
+    static const int  yield_every = [] { const char * e = getenv("GGML_OPENCL_YIELD_EVERY"); return e ? atoi(e) : 0; }();
+    static const int  yield_us    = [] { const char * e = getenv("GGML_OPENCL_YIELD_US"); return e ? atoi(e) : 2000; }();
+    static const bool yield_log   = getenv("GGML_OPENCL_YIELD_LOG") != nullptr;
+    int since_yield = 0, waits = 0;
+    double wait_ms = 0.0, max_ms = 0.0;
+    const ggml_tensor * last = nullptr;
+    const ggml_tensor * max_node = nullptr;
+
     for (int i = 0; i < cgraph->n_nodes; i++) {
         ggml_tensor * node = cgraph->nodes[i];
 
@@ -8222,6 +8237,24 @@
             continue;
         }
 
+        if (yield_every > 0 && since_yield >= yield_every) {
+            const auto t0 = std::chrono::steady_clock::now();
+            clFinish(backend_ctx->queue);
+            const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+            wait_ms += ms;
+            waits++;
+            if (ms > max_ms) {
+                max_ms   = ms;
+                max_node = last;
+            }
+            if (yield_us > 0) {
+                std::this_thread::sleep_for(std::chrono::microseconds(yield_us));
+            }
+            since_yield = 0;
+        }
+        since_yield++;
+        last = node;
+
         if (!backend_ctx->disable_fusion && ggml_opencl_can_fuse(backend_ctx, cgraph, i, { GGML_OP_NORM, GGML_OP_MUL, GGML_OP_ADD })) {
             ggml_opencl_op_norm_fused(backend, node, cgraph->nodes[i+1], cgraph->nodes[i+2]);
             i += 2;
@@ -8305,6 +8338,12 @@
         GGML_ASSERT(ok);
     }
 
+    if (yield_every > 0 && yield_log) {
+        GGML_LOG_INFO("ggml_opencl: yield every %d op(s): %d waits, %.1f ms waited, longest %.1f ms after %s (%s)\n",
+                      yield_every, waits, wait_ms, max_ms, max_node ? max_node->name : "-",
+                      max_node ? ggml_op_desc(max_node) : "-");
+    }
+
     return GGML_STATUS_SUCCESS;
 }
 
