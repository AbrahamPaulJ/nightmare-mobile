+    // nightmare (dit/037): Q/K norm and rope as ONE fused op (the HTP's qknorm_rope), as FLUX.2, Krea 2, Z-Image and
+    // Qwen already do and dit/029 / dit/035 added for Ideogram 4 and MOSS. Iris's rope table is FLUX-style interleaved
+    // pairs (image_rope, Pid::make_rope_1d), the kernel's own order, so no channel permutation is needed. The composed
+    // Rope::apply_rope is permutes, conts and REPEATs per q and k in each of 24 trunk and 4 pixel blocks.
+    // NM_IRIS_COMPOSED_ROPE=1 keeps the old path (the A/B control).
+    class IrisQKNorm : public RMSNorm {
+    public:
+        using RMSNorm::RMSNorm;
+
+        // x: [d, H, L, 1] straight off the projection, NOT normed. Returns [d, L, H] normed and roped, or nullptr.
+        ggml_tensor* forward_rope(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* pe) {
+            static const bool composed = getenv("NM_IRIS_COMPOSED_ROPE") != nullptr;
+            if (composed || ctx->backend == nullptr || x->ne[3] != 1 || x->type != GGML_TYPE_F32) {
+                return nullptr;
+            }
+            ggml_tensor* w = params["weight"];
+            if (ctx->weight_adapter) {
+                w = ctx->weight_adapter->patch_weight(ctx->ggml_ctx, ctx->backend, w, prefix + "weight");
+            }
+            ggml_tensor* out = ggml_qknorm_rope(ctx->ggml_ctx, x, w, pe, eps);
+            return ggml_backend_supports_op(ctx->backend, out) ? out : nullptr;
+        }
+    };
+
+    // Rows [from, from + n) of a rope table [2, 2, d/2, L] (the text part, then the image part, of a joint table).
+    inline ggml_tensor* rope_rows(ggml_context* c, ggml_tensor* pe, int64_t from, int64_t n) {
+        return ggml_view_4d(c, pe, pe->ne[0], pe->ne[1], pe->ne[2], n, pe->nb[1], pe->nb[2], pe->nb[3], from * pe->nb[3]);
+    }
+
+    // q, k, v: [d, H, L, 1] off the projection, q and k NOT normed. Fused norm + rope, else the composed path.
+    inline ggml_tensor* attend(GGMLRunnerContext* ctx, IrisQKNorm* nq, IrisQKNorm* nk, ggml_tensor* q, ggml_tensor* k,
+                               ggml_tensor* v, ggml_tensor* pe, ggml_tensor* mask) {
+        ggml_tensor* qr = nq->forward_rope(ctx, q, pe);
+        ggml_tensor* kr = qr != nullptr ? nk->forward_rope(ctx, k, pe) : nullptr;
+        if (qr != nullptr && kr != nullptr) {
+            return ggml_ext_attention_ext(ctx->ggml_ctx, ctx->backend, qr, kr, v, q->ne[1], mask, true, ctx->flash_attn_enabled);
+        }
+        return Rope::attention(ctx, nq->forward(ctx, q), nk->forward(ctx, k), v, pe, mask);
+    }
