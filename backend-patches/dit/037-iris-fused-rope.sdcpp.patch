+        // project() without the q/k norms, for the fused path, which norms and ropes in one op.
+        std::array<ggml_tensor*, 3> project_raw(GGMLRunnerContext* ctx, ggml_tensor* h, const std::string& suffix) {
+            auto c        = ctx->ggml_ctx;
+            std::string a = dual ? "attn." : "";
+            auto q        = ggml_reshape_4d(c, linear(ctx, a + "q_proj" + suffix, h), config.head_dim, config.num_heads, h->ne[1], h->ne[2]);
+            auto k        = ggml_reshape_4d(c, linear(ctx, a + "k_proj" + suffix, h), config.head_dim, config.kv_heads, h->ne[1], h->ne[2]);
+            auto v        = ggml_reshape_4d(c, linear(ctx, a + "v_proj" + suffix, h), config.head_dim, config.kv_heads, h->ne[1], h->ne[2]);
+            return {q, k, v};
+        }
