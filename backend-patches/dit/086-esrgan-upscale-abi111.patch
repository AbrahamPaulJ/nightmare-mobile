+// nightmare (dit/086): ABI 111, an imported ESRGAN through stable-diffusion.cpp's upscaler.
+bool engine_upscale(const dit_upscale_params *params, uint8_t **out_rgb, int *out_width,
+                    int *out_height, int *out_factor) {
+  if (!params || !params->model_path || !params->rgb || params->width <= 0 || params->height <= 0 ||
+      !out_rgb || !out_width || !out_height) {
+    g_create_error = "upscale: invalid parameters";
+    return false;
+  }
+  upscaler_ctx_t *up = new_upscaler_ctx(params->model_path, /*direct=*/false,
+                                        params->n_threads > 0 ? params->n_threads : 4,
+                                        params->tile_size, params->backend, nullptr);
+  if (!up) {
+    g_create_error = std::string("upscale: cannot load ") + params->model_path;
+    return false;
+  }
+  const int factor = get_upscale_factor(up);
+  sd_image_t in = {static_cast<uint32_t>(params->width), static_cast<uint32_t>(params->height), 3,
+                   const_cast<uint8_t *>(params->rgb)};
+  sd_image_t *outs = nullptr;
+  int n = 0;
+  const bool ok = upscale(up, in, static_cast<uint32_t>(factor), &outs, &n);
+  free_upscaler_ctx(up);
+  if (!ok || n < 1 || !outs || !outs[0].data) {
+    if (outs) free_sd_images(outs, std::max(0, n));
+    g_create_error = "upscale failed";
+    return false;
+  }
+  const sd_image_t &o = outs[0];
+  size_t pixel_count = 0;
+  if (!image_pixel_count(o, &pixel_count) || (o.channel != 3 && o.channel != 4)) {
+    free_sd_images(outs, n);
+    g_create_error = "upscale: unsupported output";
+    return false;
+  }
+  uint8_t *rgb = static_cast<uint8_t *>(malloc(pixel_count * 3));
+  if (!rgb) {
+    free_sd_images(outs, n);
+    g_create_error = "upscale: out of memory";
+    return false;
+  }
+  if (o.channel == 4) image_to_rgb(o, pixel_count, rgb); else memcpy(rgb, o.data, pixel_count * 3);
+  *out_rgb = rgb;
+  *out_width = static_cast<int>(o.width);
+  *out_height = static_cast<int>(o.height);
+  if (out_factor) *out_factor = factor;
+  free_sd_images(outs, n);
+  return true;
+}
