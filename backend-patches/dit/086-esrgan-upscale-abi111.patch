+// --- ABI 111 ---
+// An ESRGAN-family upscaler the person imported (a .pth / .safetensors from CivitAI), through
+// stable-diffusion.cpp's own upscaler. Needs no dit_ctx: the backend calls it from any process.
+typedef struct {
+  const char *model_path;
+  // ggml device spec, e.g. "HTP0" or "CPU"; NULL = the engine's default.
+  const char *backend;
+  int n_threads;
+  // Tile edge in pixels (0 = the engine's default); smaller tiles, less memory.
+  int tile_size;
+  // The picture, interleaved RGB8.
+  const uint8_t *rgb;
+  int width;
+  int height;
+} dit_upscale_params;
