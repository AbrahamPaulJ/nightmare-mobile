 namespace Flux {
 
+    // nightmare (dit/096): FLUX.1's raw q.k overflows fp16 on Hexagon (without flash attention its K^T Q matmul went
+    // inf and the picture broke), and with flash attention it drew fine stripes in fur and skin. ggml_ext_attention_ext's
+    // kv_scale ("avoid overflow", the 1/128 Ideogram 4 takes in dit/029) shrinks K and V before their fp16 cast and
+    // divides the result back. FLUX.1 only (vector_in, not Chroma): FLUX.2 Klein shares this file and is clean.
+    // NM_FLUX1_KV_SCALE replaces the default.
+    static bool& nm_flux1_htp() {
+        static bool on = false;
+        return on;
+    }
+
+    static float nm_flux1_kv_scale(GGMLRunnerContext* ctx) {
+        if (!nm_flux1_htp() || ctx->backend == nullptr || !sd_backend_is(ctx->backend, "HTP")) {
+            return 1.f;
+        }
+        static const float s = [] {
+            const char* e = getenv("NM_FLUX1_KV_SCALE");
+            float v       = e && e[0] ? (float)atof(e) : NM_FLUX1_KV_SCALE_DEFAULT;
+            if (!(v > 0.f)) v = 1.f;
+            LOG_INFO("flux: FLUX.1 HTP attention kv_scale %g", v);
+            return v;
+        }();
+        return s;
+    }
