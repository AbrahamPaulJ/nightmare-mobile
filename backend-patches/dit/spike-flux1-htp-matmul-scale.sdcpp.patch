 namespace Flux {
 
+    // nightmare (dit/096): FLUX.1 dev on Hexagon draws fine vertical stripes in fur and skin (a tester's 12-step render and
+    // our 20-step bench, 2026-11-10). A matmul's result passes through fp16 there, the class dit/025 (Z-Image) and dit/045
+    // (FLUX.3) fixed: Linear::set_scale runs x * s through the matmul and the result / s. FLUX.1 only (vector_in, not Chroma):
+    // FLUX.2 Klein shares this file and is clean. Per projection, NM_FLUX1_HTP_SCALE="name:scale,..." replaces the default
+    // ("all" matches every one; "none:1" turns it off). Names: img_in txt_in img_qkv img_proj img_mlp0 img_mlp2 txt_qkv
+    // txt_proj txt_mlp0 txt_mlp2 linear1 linear2 final.
+    static bool& nm_flux1_htp() {
+        static bool on = false;
+        return on;
+    }
+
+    static float nm_flux1_scale(GGMLRunnerContext* ctx, const char* name) {
+        if (!nm_flux1_htp() || ctx->backend == nullptr || !sd_backend_is(ctx->backend, "HTP")) {
+            return 1.f;
+        }
+        static const std::vector<std::pair<std::string, float>> table = [] {
+            std::vector<std::pair<std::string, float>> t;
+            const char* e    = getenv("NM_FLUX1_HTP_SCALE");
+            std::string spec = e ? e : NM_FLUX1_HTP_SCALE_DEFAULT;
+            size_t pos       = 0;
+            while (pos < spec.size()) {
+                size_t end = spec.find(',', pos);
+                if (end == std::string::npos) end = spec.size();
+                std::string item = spec.substr(pos, end - pos);
+                size_t colon     = item.find(':');
+                if (colon != std::string::npos) {
+                    t.emplace_back(item.substr(0, colon), (float)atof(item.c_str() + colon + 1));
+                }
+                pos = end + 1;
+            }
+            LOG_INFO("flux: FLUX.1 HTP matmul scales '%s'", spec.c_str());
+            return t;
+        }();
+        for (const auto& [n, v] : table) {
+            if ((n == "all" || n == name) && v > 0.f) return v;
+        }
+        return 1.f;
+    }
+
+    static void nm_flux1_set(GGMLRunnerContext* ctx, const std::shared_ptr<GGMLBlock>& block, const char* name) {
+        auto l = std::dynamic_pointer_cast<Linear>(block);
+        if (l && nm_flux1_htp()) l->set_scale(nm_flux1_scale(ctx, name));
+    }
