+// nightmare (ABI 106): Wan 2.2 TI2V text/image to video. Mirrors the sd-cli
+// invocation measured on the phone (docs/VIDEO-GGML.md in nightmare-mobile).
+bool engine_generate_video(dit_ctx *ctx, const dit_video_params *params,
+                           dit_progress_cb progress, dit_preview_cb preview,
+                           dit_frame_cb on_frame, void *user_data) {
+  if (!ctx || !ctx->sd || !params || !on_frame) return false;
+  ctx->last_error.clear();
+
+  std::lock_guard<std::mutex> lock(g_gen_mutex);
+
+  sd_vid_gen_params_t gen;
+  sd_vid_gen_params_init(&gen);
+  gen.prompt = params->prompt ? params->prompt : "";
+  gen.negative_prompt = params->negative_prompt ? params->negative_prompt : "";
+  gen.width = params->width;
+  gen.height = params->height;
+  gen.seed = params->seed;
+  if (params->frames > 0) gen.video_frames = params->frames;
+  if (params->fps > 0) gen.fps = params->fps;
+  gen.sample_params.sample_steps = std::max(1, params->steps);
+  gen.sample_params.guidance.txt_cfg = params->cfg_scale;
+  if (params->flow_shift > 0.0f) gen.sample_params.flow_shift = params->flow_shift;
+  if (params->sample_method && params->sample_method[0])
+    gen.sample_params.sample_method = str_to_sample_method(params->sample_method);
+  std::vector<float> sigmas;
+  if (params->sigmas && params->sigma_count > 1) {
+    sigmas.assign(params->sigmas, params->sigmas + params->sigma_count);
+    gen.sample_params.custom_sigmas = sigmas.data();
+    gen.sample_params.custom_sigmas_count = static_cast<int>(sigmas.size());
+  }
+
+  if (params->start_image_rgb && params->start_width > 0 && params->start_height > 0) {
+    gen.init_image.width = static_cast<uint32_t>(params->start_width);
+    gen.init_image.height = static_cast<uint32_t>(params->start_height);
+    gen.init_image.channel = 3;
+    gen.init_image.data = const_cast<uint8_t *>(params->start_image_rgb);
+  }
+
+  std::vector<sd_lora_t> loras;
+  if (params->lora_count > 0) {
+    if (!params->lora_paths) {
+      ctx->last_error = "invalid loras";
+      return false;
+    }
+    for (int i = 0; i < params->lora_count; ++i) {
+      if (!params->lora_paths[i] || !params->lora_paths[i][0]) {
+        ctx->last_error = "empty lora path";
+        return false;
+      }
+      sd_lora_t lora{};
+      lora.is_high_noise = false;
+      lora.multiplier =
+          params->lora_multipliers ? params->lora_multipliers[i] : 1.0f;
+      lora.path = params->lora_paths[i];
+      loras.push_back(lora);
+    }
+    gen.loras = loras.data();
+    gen.lora_count = static_cast<uint32_t>(loras.size());
+  }
+
+  gen.vae_tiling_params.temporal_tiling = params->temporal_tiling;
+  if (params->tiling_args && params->tiling_args[0])
+    gen.vae_tiling_params.extra_tiling_args = params->tiling_args;
+  if (params->vae_tile_size > 0) {
+    gen.vae_tiling_params.enabled = true;
+    gen.vae_tiling_params.tile_size_x = params->vae_tile_size;
+    gen.vae_tiling_params.tile_size_y = params->vae_tile_size;
+    gen.vae_tiling_params.target_overlap = params->vae_tile_overlap;
+  }
+
+  const int sampling_steps =
+      sigmas.size() > 1 ? static_cast<int>(sigmas.size()) - 1 : std::max(1, params->steps);
+  g_active = ActiveGeneration{progress, preview, user_data, ctx, false, false,
+                              sampling_steps};
+  sd_set_progress_callback(progress ? forward_progress : nullptr, nullptr);
+  if (preview && ctx->preview_interval > 0) {
+    sd_set_preview_callback(forward_preview, PREVIEW_PROJ, ctx->preview_interval,
+                            /*denoised=*/true, /*noisy=*/false, nullptr);
+  } else {
+    sd_set_preview_callback(nullptr, PREVIEW_NONE, 0, false, false, nullptr);
+  }
+
+  sd_image_t *frames = nullptr;
+  int frame_count = 0;
+  sd_audio_t *audio = nullptr;
+  const bool ok = generate_video(ctx->sd, &gen, &frames, &frame_count, &audio);
+
+  sd_set_progress_callback(nullptr, nullptr);
+  sd_set_preview_callback(nullptr, PREVIEW_NONE, 0, false, false, nullptr);
+  const bool cancelled = g_active.cancelled;
+  g_active = ActiveGeneration{};
+  if (cancelled) sd_cancel_generation(ctx->sd, SD_CANCEL_RESET);
+  if (audio) free_sd_audio(audio);
+
+  if (!ok || frame_count < 1 || !frames) {
+    ctx->last_error = cancelled ? "cancelled" : "generate_video failed";
+    if (frames) free_sd_images(frames, std::max(0, frame_count));
+    return false;
+  }
+
+  bool delivered = true;
+  std::vector<uint8_t> rgb;
+  for (int i = 0; i < frame_count && delivered; ++i) {
+    const sd_image_t &frame = frames[i];
+    size_t pixel_count = 0;
+    if (!frame.data || !image_pixel_count(frame, &pixel_count) ||
+        (frame.channel != 3 && frame.channel != 4)) {
+      ctx->last_error = "unsupported video frame " + std::to_string(i);
+      delivered = false;
+      break;
+    }
+    const uint8_t *data = frame.data;
+    if (frame.channel == 4) {
+      rgb.resize(pixel_count * 3);
+      image_to_rgb(frame, pixel_count, rgb.data());
+      data = rgb.data();
+    }
+    if (!on_frame(i, frame_count, data, static_cast<int>(frame.width),
+                  static_cast<int>(frame.height), user_data)) {
+      ctx->last_error = "frame delivery stopped";
+      delivered = false;
+    }
+  }
+  free_sd_images(frames, frame_count);
+  return delivered;
+}
