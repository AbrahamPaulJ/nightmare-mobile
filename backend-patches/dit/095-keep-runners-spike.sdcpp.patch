+// dit/095, a spike (the list's H1c): NM_KEEP_RUNNERS=1 keeps a runner's weights staged on its compute backend when the
+// stage ends, so the next render does not load the DiT and the text encoder again (~3.4 s of 12.7 s, Anima 512x768).
+// The workspace (activations) is still freed. A LoRA change or a model change sets nm_force_runner_end: a staged copy
+// would not see a LoRA merged into the weights, nor a replaced file.
+bool nm_force_runner_end = false;
+
+static bool nm_keep_runners() {
+    static const bool keep = std::getenv("NM_KEEP_RUNNERS") != nullptr;
+    return keep;
+}
