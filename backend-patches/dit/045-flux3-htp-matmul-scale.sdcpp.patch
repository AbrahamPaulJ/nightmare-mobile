+    // nightmare (dit/045): on Hexagon a matmul's result passes through fp16, and FLUX.3's overflows it (the S25: noise
+    // with every matmul on the NPU, the CPU's picture with MUL_MAT filtered off). Linear::set_scale runs x * s
+    // through the matmul and the result / s, as dit/025 does for Z-Image's attention.out. Measured on the S25 (256²,
+    // 4 steps against upstream's CUDA render): txt_in OR mlp_out alone is still noise, both at 1/4 to 1/64 render
+    // right (29.4-29.6 dB; the phone's CPU 33.2), so the default is both at 1/32. Per projection name,
+    // NM_FLUX3_HTP_SCALE="name:scale,..." ("all" matches every one) replaces it.
+    static float htp_scale_for(GGMLRunnerContext* ctx, const std::string& name) {
+        if (!sd_backend_is(ctx->backend, "HTP")) {
+            return 1.f;
+        }
+        static const std::vector<std::pair<std::string, float>> table = [] {
+            std::vector<std::pair<std::string, float>> t;
+            const char* e = getenv("NM_FLUX3_HTP_SCALE");
+            std::string spec = e ? e : "txt_in:0.03125,mlp_out:0.03125";
+            size_t pos = 0;
+            while (pos < spec.size()) {
+                size_t end = spec.find(',', pos);
+                if (end == std::string::npos) end = spec.size();
+                std::string item = spec.substr(pos, end - pos);
+                size_t colon     = item.find(':');
+                if (colon != std::string::npos) {
+                    t.emplace_back(item.substr(0, colon), (float)atof(item.c_str() + colon + 1));
+                }
+                pos = end + 1;
+            }
+            return t;
+        }();
+        for (const auto& [n, v] : table) {
+            if (n == "all" || n == name) return v;
+        }
+        return 1.f;
+    }
+
+    static ggml_tensor* scaled_linear(GGMLRunnerContext* ctx, const std::shared_ptr<Linear>& l, const std::string& name, ggml_tensor* x) {
+        l->set_scale(htp_scale_for(ctx, name));
+        return l->forward(ctx, x);
+    }
