+    auto dst_extra         = (const ggml_hexagon_tensor_extra *) dst->extra;
+    if ((src_extra && (src_extra->flags & special)) || (dst_extra && (dst_extra->flags & special)) ||
+        src->data == nullptr || dst->data == nullptr) {
