+    // A direct conv takes one image (ne[3] == 1) on the Hexagon backend, and TAEHV keeps a
+    // video's frames there, so every conv of a decode ran on the CPU (30 of 31 s at
+    // 512x320x17). Convolve each image through the direct kernel, written in place into
+    // one output. Returns nullptr when there is one image or the kernel cannot run it.
+    ggml_tensor* try_forward_per_image(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* w, ggml_tensor* b) {
+        if (x->ne[3] <= 1 || ctx->backend == nullptr || !ctx->conv2d_direct_enabled ||
+            ctx->circular_x_enabled || ctx->circular_y_enabled || scale != 1.f ||
+            !ggml_is_contiguous(x)) {
+            return nullptr;
+        }
+        ggml_context* c  = ctx->ggml_ctx;
+        ggml_tensor* out = nullptr;
+        for (int64_t i = 0; i < x->ne[3]; i++) {
+            ggml_tensor* xi = ggml_view_4d(c, x, x->ne[0], x->ne[1], x->ne[2], 1,
+                                           x->nb[1], x->nb[2], x->nb[3], i * x->nb[3]);
+            ggml_tensor* yi = b != nullptr
+                                  ? ggml_conv_2d_direct_bias(c, w, xi, b,
+                                                             stride.second, stride.first, padding.second, padding.first,
+                                                             dilation.second, dilation.first)
+                                  : ggml_conv_2d_direct(c, w, xi,
+                                                        stride.second, stride.first, padding.second, padding.first,
+                                                        dilation.second, dilation.first);
+            if (!ggml_backend_supports_op(ctx->backend, yi)) {
+                return nullptr;
+            }
+            if (out == nullptr) {
+                out = ggml_new_tensor_4d(c, yi->type, yi->ne[0], yi->ne[1], yi->ne[2], x->ne[3]);
+            }
+            out = ggml_set_inplace(c, out, yi, out->nb[1], out->nb[2], out->nb[3], i * out->nb[3]);
+        }
+        return out;
+    }
