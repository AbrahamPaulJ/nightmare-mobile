+    // NM_WAN_TOKEN_CHUNK=<tokens> sets the chunk (0 = off). Default: 4096 for dim >= 5120 (2048 needed MORE at 832x480 5 s: more joins) (the 14B), off for the 5B.
+    static int64_t wan_token_chunk(int64_t dim) {
+        static const int64_t env = [] {
+            const char* e = getenv("NM_WAN_TOKEN_CHUNK");
+            return e ? (int64_t)atoll(e) : (int64_t)-1;
+        }();
+        if (env >= 0) {
+            return env;
+        }
+        return dim >= 5120 ? 4096 : 0;
+    }
