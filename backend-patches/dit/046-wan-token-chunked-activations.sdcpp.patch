+    // nightmare (dit/046): WanAttentionBlock::forward_chunked, defined after the class for the helpers above it.
+    inline ggml_tensor* WanAttentionBlock::forward_chunked(GGMLRunnerContext* ctx, ggml_tensor* x,
+                                                           const std::vector<ggml_tensor*>& es, ggml_tensor* pe,
+                                                           ggml_tensor* context, int64_t context_img_len, int64_t chunk) {
+        auto gc         = ctx->ggml_ctx;
+        auto norm1      = std::dynamic_pointer_cast<LayerNorm>(blocks["norm1"]);
+        auto self_attn  = std::dynamic_pointer_cast<WanSelfAttention>(blocks["self_attn"]);
+        auto norm3      = std::dynamic_pointer_cast<UnaryBlock>(blocks["norm3"]);
+        auto cross_attn = std::dynamic_pointer_cast<WanCrossAttention>(blocks["cross_attn"]);
+        auto norm2      = std::dynamic_pointer_cast<LayerNorm>(blocks["norm2"]);
+        auto ffn_0      = std::dynamic_pointer_cast<Linear>(blocks["ffn.0"]);
+        auto ffn_2      = std::dynamic_pointer_cast<Linear>(blocks["ffn.2"]);
+        const int64_t n = x->ne[1];
+        // pass 1: every chunk's keys and values
+        ggml_tensor *K = nullptr, *V = nullptr;
+        for (int64_t s = 0; s < n; s += chunk) {
+            const int64_t len = std::min(chunk, n - s);
+            auto y            = modulate_fused(ctx, norm1->forward(ctx, wan_token_rows(gc, x, s, len)), es[0], es[1]);
+            auto kv           = self_attn->kv_chunk(ctx, y, wan_pe_rows(gc, pe, s, len));
+            if (kv.first == nullptr) {
+                return nullptr;
+            }
+            K = K ? ggml_concat(gc, K, kv.first, 1) : kv.first;
+            V = V ? ggml_concat(gc, V, kv.second, 1) : kv.second;
+        }
+        // pass 2: the rest of the block, a chunk at a time
+        ggml_tensor* out = nullptr;
+        for (int64_t s = 0; s < n; s += chunk) {
+            const int64_t len = std::min(chunk, n - s);
+            auto xc           = wan_token_rows(gc, x, s, len);
+            auto y            = modulate_fused(ctx, norm1->forward(ctx, xc), es[0], es[1]);
