 // Verifies the fixed per-type file layout under --model_dir and constructs
 // the matching pipeline (not yet initialized).
+// A DiT package's SHARED parts, beside the model directories rather than
+// inside one.
+//
+// A DiT family loads plain weights at run time, so a user can bring their own
+// `dit.safetensors` -- but the text encoder, VAE and tokenizer that go with it
+// are ours and identical for every model of that family. Copying 2.6 GB of
+// them into each imported model is the alternative, and it is the whole reason
+// this exists.
+//
+// Symlinks are not an option: the models live on Android's FUSE-emulated
+// external storage, where neither symlinks nor hard links work.
+static constexpr const char *kDitSharedDir = "_dit_shared";
+
+// One model file: the model's OWN directory first, then the shared one.
+//
+// Returns the model's own path when neither exists, so the caller's "File not
+// found" names the file the user expects rather than an internal fallback.
+static std::string ditFile(const std::filesystem::path &dir, const char *name) {
+  const auto own = dir / name;
+  if (std::filesystem::exists(own)) return own.string();
+  const auto shared = dir.parent_path() / kDitSharedDir / name;
+  if (std::filesystem::exists(shared)) return shared.string();
+  return own.string();
+}
