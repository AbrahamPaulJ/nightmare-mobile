<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ⚠ INTERNET is for localhost only. The backend is an HTTP server in this
         same app's process tree; nothing leaves the device, and "generates
         entirely offline" is the product claim (docs/ARCHITECTURE.md section 7).
         Any future plugin download must be host-mediated and manifest-declared,
         never a raw socket from JS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- For OpService, the headless op runner. "Foreground" here means process
         priority, not the screen: it is what keeps a 30 s render alive while the
         app has no window, and Android 12+ refuses a plain background service
         start outright. SPECIAL_USE is the honest type; this is a developer
         harness, not a media player or a data sync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ⚠ The icons are GENERATED by tools/build_icon.py from icon-source.png;
         everything under res/mipmap-* is an output, not artwork to hand-edit.
         The adaptive pair in mipmap-anydpi-v26 is what Android 8+ actually
         draws, and its foreground layer is composed with a far larger margin
         than the square icon because the launcher masks the outer ~17% away. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nightmare"
        tools:targetApi="31"
        xmlns:tools="http://schemas.android.com/tools"
        android:usesCleartextTraffic="true">
        <!-- ⭐ Sharing a picture or a flow to another app.
             ⚠ Android has refused raw `file://` URIs across app boundaries
             since API 24, so a share hands out a `content://` URI with a
             one-shot read grant instead. `Share.kt` stages every file into
             cacheDir/share/, which is the only path res/xml/file_paths.xml
             exposes — a broader root would expose model archives mid-download.
             ⚠ `exported=false` with grants: the provider is not open to the
             world, each share opens one door for one URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ⚠⚠ singleTop is LOAD-BEARING, not a preference.
             Intent.filterEquals() ignores extras, so at the default launchMode
             a second `am start` naming this same component is treated as a
             duplicate of the intent already on top: AMS prints "intent has
             been delivered to currently running top-most instance" and
             onNewIntent() is never called. The op is dropped in total silence:
             no log line, no error, the screen unchanged, which is
             indistinguishable from an op that ran and did nothing. Measured
             2026-09-08, when an `op sample` extra did nothing at all and the
             same intent carrying FLAG_ACTIVITY_SINGLE_TOP (0x20000000) ran
             immediately. Declaring it here fixes it for every caller instead
             of asking every caller to remember the flag.
             notes/HANDOFF.md section 5.
             ⚠ And no double hyphen may appear in this comment: XML forbids it
             inside a comment, and the manifest merger reports it only as
             "Error parsing AndroidManifest.xml" with no line number. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nightmare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The headless front end: same ops, no window.
             Started by `am startservice` with the same "op" string extra the
             activity takes (the exact command is in notes/HANDOFF.md section 5;
             it cannot be written here because XML forbids a double hyphen
             inside a comment, and the merger reports that only as "Error
             parsing AndroidManifest.xml" with no line number).
             exported so the shell can start it; there is no other caller and
             nothing sensitive behind it (the ops it runs are all local, and
             the backend it drives already listens on loopback). The phone is
             somebody's actual phone, and taking their screen for a 30 s check
             is not something a test loop should ever need to do.
             notes/HANDOFF.md section 5. -->
        <service
            android:name=".OpService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="developer harness: runs a backend op with no UI" />
        </service>
    </application>

</manifest>
