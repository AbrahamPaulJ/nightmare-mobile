{
  "id": "com.nightmare.resize-pack",
  "version": "0.1.0",
  "api": 1,
  "nodes": [
    {
      "type": "Resize",
      "category": "image",
      "tier": 0,
      "inputs":  [{ "name": "image", "type": "IMAGE" }],
      "outputs": [{ "name": "image", "type": "IMAGE" }],
      "widgets": [
        { "name": "scale", "type": "float", "default": 0.5, "min": 0.05, "max": 4.0 }
      ]
    }
  ],
  "permissions": ["image"]
}
