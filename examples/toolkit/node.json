{
  "id": "com.example.toolkit",
  "version": "0.1.0",
  "api": 1,
  "nodes": [
    {
      "type": "Framed",
      "category": "image",
      "tier": 0,
      "inputs":  [{ "name": "image", "type": "IMAGE" }],
      "outputs": [{ "name": "image", "type": "IMAGE" }],
      "widgets": [
        { "name": "margin", "type": "int",    "default": 12, "min": 0, "max": 256 },
        { "name": "color",  "type": "string", "default": "#f5f0e6" }
      ]
    },
    {
      "type": "Desaturate",
      "category": "image",
      "tier": 0,
      "inputs":  [{ "name": "image", "type": "IMAGE" }],
      "outputs": [{ "name": "image", "type": "IMAGE" }],
      "widgets": [
        { "name": "amount", "type": "float", "default": 0.6, "min": 0.0, "max": 1.0 }
      ]
    }
  ],
  "permissions": ["image"]
}
